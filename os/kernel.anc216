; ANC216 kernel entry and module composition. All imported labels share this origin.
; IMEM 0100..2eff kernel; 3000..31ef system stack; 3200..3fff executable staging;
; 4000..7fff isolated user memory, with its stack at 7800..7ffc.
org 0x0100
entry:
    clri
    clrt
    careq
    ldsp 0x3000
    ldbp 0x3000
    store & 0x0000, word entry
    store & 0x0002, word keyboard_irq
    store & 0x0004, word fault_handler
    store & 0x0006, word syscall_handler
    store & 0x0008, word panic
    store & 0x000a, word shutdown_handler
    store & 0x000c, word 0x3100
    write & 0xfffd, word 0x0500
    write & 0xfffd, word 0x0200
    write & 0xfffd, word 0x07ff
    write & 0xfffd, word 0x0800
    write & 0xfffd, word 0x0500
    store & 0x00f0, word 0x2160
    ; Try the conventional boot volume. An absent/unformatted chip is optional.
    load r1, 0x0200
    phbp
    call fs_mount
    pobp
    cmp r7, 0
    jne idle
    load r1, init_path
    load r2, sizeof init_path
    phbp
    call fs_open
    pobp
    cmp r7, 0
    jne idle
    ; exec enters user mode and never RETs after successful loading.
    phbp
    call exec_open_file
    pobp
idle:
    seti
    jmp idle

; Kernel faults halt. User faults terminate the process and retain the fault code.
fault_handler:
    cmp r0, 5
    jeq soft_reset
    load r1, & process_active
    cmp r1, 0
    jeq panic
    store & 0x00f4, r0
    store & 0x00f0, word 0x2162
    jmp process_finish
; Soft reset abandons the old frame and reruns firmware; attached chips persist.
soft_reset:
    clri
    clrt
    ldsp 0x3000
    ldbp 0x3000
    store & process_active, word 0
    jmp 0xff00
shutdown_handler:
    ; Shutdown pin has no CALL/interrupt frame to restore.
    store & 0x00f0, word 0x2164
    kill
panic:
    store & 0x00f0, word 0xffff
    kill
init_path:
    "/bin/init"

import "kernel/console.anc216"
import "kernel/storage.anc216"
import "kernel/fs.anc216"
import "kernel/loader.anc216"
import "kernel/syscalls.anc216"
import "kernel/keyboard.anc216"
