; AFS v1 filesystem over MPME216. One mounted volume and one descriptor (1).
; Mounting another chip closes the descriptor; any EMEM address can be mounted.
; Paths are absolute, with directories up to 15 bytes and file names 17+3.
; The cardreader owns formatting/allocation. Guest writes overwrite allocated
; file bytes in place; EOF does not extend the chain or resize the file.
; R7 is the status: 0 success, 1 invalid input, 2 device/format, 3 not found,
; 4 no descriptor, 5 corrupt chain, 6 capacity. All entry points clobber scratch
; registers. They preserve their CALL frame BP even when using BP as a pointer.

; fs_mount(R1=EMEM address): require the MPME ID and AFS magic/version.
fs_mount:
    store & fs_device, r1
    store & fs_mounted, word 0
    store & fs_head, word 0
    phbp
    ldbp r1
    ireq & bp + 0
    pobp
    cmp r0, 0x0102
    jne fs_bad_device
    load r1, 0
    phbp
    call disk_word
    pobp
    cmp r1, 0xfe01
    jne fs_bad_device
    store & fs_mounted, word 1
    load r7, 0
    ret
fs_bad_device:
    store & fs_device, word 0
    load r7, 2
    ret

; fs_open(R1=physical path, R2=byte length): copy to a bounded kernel buffer.
; Components are resolved by scanning directory parents; no host FS is used.
fs_open:
    phbp
    store & fs_head, word 0
    load r0, & fs_mounted
    cmp r0, 0
    jeq fs_open_device
    cmp r2, 1
    jle fs_open_bad
    cmp r2, 255
    jgr fs_open_bad
    load r3, fs_path
    tran r4, r1
    tran r5, r2
fs_copy_path:
    ldbp r4
    load l0, & bp + 0
    ldbp r3
    store & bp + 0, l0
    inc r4
    inc r3
    dec r5
    jne fs_copy_path
    ldbp r3
    store & bp + 0, byte 0
    load r0, & fs_path
    shr r0, 8
    cmp r0, 47
    jne fs_open_bad
    store & fs_parent, word 0
    load r4, fs_path + 1
fs_component:
    ; Clear a 20-byte fixed-field name before extracting each component.
    load r3, fs_name
    load r5, 20
fs_clear_name:
    ldbp r3
    store & bp + 0, byte 0
    inc r3
    dec r5
    jne fs_clear_name
    load r3, fs_name
    load r5, 0
    store & fs_dot, word 0
fs_component_char:
    ldbp r4
    load r0, 0
    load l0, & bp + 0
    cmp r0, 0
    jeq fs_file_scan_start
    cmp r0, 47
    jeq fs_dir_scan_start
    cmp r0, 46
    jeq fs_extension
    cmp r5, 20
    jge fs_open_bad
    ldbp r3
    store & bp + 0, l0
    inc r3
    inc r4
    inc r5
    load r0, & fs_dot
    cmp r0, 0
    jne fs_component_char
    cmp r5, 17
    jgr fs_open_bad
    jmp fs_component_char
fs_extension:
    ; The on-disk extension is a separate three-byte field.
    load r0, & fs_dot
    cmp r0, 0
    jne fs_open_bad
    cmp r5, 0
    jeq fs_open_bad
    store & fs_dot, word 1
    load r3, fs_name + 17
    load r5, 17
    inc r4
    jmp fs_component_char
fs_dir_scan_start:
    cmp r5, 0
    jeq fs_open_bad
    cmp r5, 15
    jgr fs_open_bad
    load r0, & fs_dot
    cmp r0, 0
    jne fs_open_bad
    inc r4
    store & fs_path_cursor, r4
    load r4, 1
    load r5, 649
fs_dir_scan:
    tran r1, r5
    phbp
    call disk_byte
    pobp
    cmp r1, & fs_parent
    jne fs_dir_next
    tran r2, r5
    inc r2
    load r3, fs_name
    load r6, 15
    phbp
    call fs_match
    pobp
    cmp r7, 0
    jeq fs_dir_found
fs_dir_next:
    inc r4
    add r5, 16
    cmp r4, 97
    jne fs_dir_scan
    jmp fs_open_missing
fs_dir_found:
    store & fs_parent, r4
    load r4, & fs_path_cursor
    jmp fs_component
fs_file_scan_start:
    cmp r5, 0
    jeq fs_open_bad
    load r4, 1
fs_file_scan:
    tran r1, r4
    dec r1
    shl r1, 1
    add r1, 257
    phbp
    call disk_word
    pobp
    load r0, & fs_parent
    shl r0, 8
    or r0, 1
    cmp r1, r0
    jne fs_file_next
    store & fs_cluster, r4
    phbp
    call fs_cluster_address
    pobp
    tran r2, r1
    load r3, fs_name
    load r6, 20
    phbp
    call fs_match
    pobp
    cmp r7, 0
    jeq fs_file_found
fs_file_next:
    inc r4
    cmp r4, 197
    jne fs_file_scan
    jmp fs_open_missing
fs_file_found:
    store & fs_head, r4
    phbp
    call fs_validate
    pobp
    cmp r7, 0
    jne fs_open_finish
    phbp
    call fs_rewind
    pobp
    jmp fs_open_finish
fs_open_bad:
    load r7, 1
    jmp fs_open_finish
fs_open_device:
    load r7, 2
    jmp fs_open_finish
fs_open_missing:
    load r7, 3
fs_open_finish:
    cmp r7, 0
    jeq fs_open_keep
    store & fs_head, word 0
fs_open_keep:
    pobp
    ret

; Compare R6 bytes at chip R2 with kernel R3. Preserve scan registers R4/R5.
fs_match:
    phbp
fs_match_loop:
    tran r1, r2
    phbp
    call disk_byte
    pobp
    ldbp r3
    load r0, 0
    load l0, & bp + 0
    cmp r0, r1
    jne fs_match_no
    inc r2
    inc r3
    dec r6
    jne fs_match_loop
    load r7, 0
    pobp
    ret
fs_match_no:
    load r7, 3
    pobp
    ret

; Cluster IDs 1..196 -> offset 2185 + (id-1)*323, using shifts/adds.
; Return in R1, preserve R0/R2 so callers retain the scan state.
fs_cluster_address:
    push r0
    push r2
    load r0, & fs_cluster
    dec r0
    tran r1, r0
    shl r1, 8
    tran r2, r0
    shl r2, 6
    add r1, r2
    add r1, r0
    shl r0, 1
    add r1, r0
    add r1, 2185
    pop r2
    pop r0
    ret

; Read the current cluster header. Sets data pointer, payload length and next ID.
fs_cluster_info:
    phbp
    call fs_cluster_address
    pobp
    store & fs_base, r1
    load r0, & fs_cluster
    cmp r0, & fs_head
    jne fs_cont_info
    add r1, 20
    phbp
    call disk_byte
    pobp
    store & fs_next, r1
    load r1, & fs_base
    add r1, 21
    phbp
    call disk_word
    pobp
    store & fs_remaining, r1
    load r1, & fs_base
    add r1, 23
    store & fs_offset, r1
    ret
fs_cont_info:
    phbp
    call disk_byte
    pobp
    store & fs_next, r1
    load r1, & fs_base
    inc r1
    phbp
    call disk_word
    pobp
    store & fs_remaining, r1
    load r1, & fs_base
    add r1, 3
    store & fs_offset, r1
    ret

; Validate the complete file chain before exposing it: IDs/types/parent/length,
; a per-ID bitmap detects cycles. A corrupt chain never becomes a descriptor.
fs_validate:
    phbp
    load r3, fs_seen
    load r4, 196
fs_seen_clear:
    ldbp r3
    store & bp + 0, byte 0
    inc r3
    dec r4
    jne fs_seen_clear
    store & fs_size, word 0
    load r0, & fs_head
    store & fs_cluster, r0
fs_validate_loop:
    load r0, & fs_cluster
    cmp r0, 1
    jls fs_corrupt
    cmp r0, 196
    jgr fs_corrupt
    tran r3, r0
    add r3, fs_seen - 1
    ldbp r3
    load l1, & bp + 0
    cmp l1, 0
    jne fs_corrupt
    store & bp + 0, byte 1
    tran r1, r0
    dec r1
    shl r1, 1
    add r1, 257
    phbp
    call disk_word
    pobp
    load r2, & fs_parent
    shl r2, 8
    load r0, & fs_cluster
    cmp r0, & fs_head
    jne fs_validate_cont
    or r2, 1
    load r4, 300
    jmp fs_validate_meta
fs_validate_cont:
    or r2, 2
    load r4, 320
fs_validate_meta:
    cmp r1, r2
    jne fs_corrupt
    phbp
    call fs_cluster_info
    pobp
    load r0, & fs_remaining
    ; Sizes with a high sign bit are necessarily outside 300/320.
    cmp r0, 0
    jls fs_corrupt
    cmp r0, r4
    jgr fs_corrupt
    add r0, & fs_size
    trsr l1
    and l1, 1
    jne fs_corrupt
    store & fs_size, r0
    load r0, & fs_next
    cmp r0, 0
    jeq fs_valid
    store & fs_cluster, r0
    jmp fs_validate_loop
fs_corrupt:
    load r7, 5
    pobp
    ret
fs_valid:
    load r7, 0
    pobp
    ret

; Reset sequential position without reparsing the path.
fs_rewind:
    load r0, & fs_head
    cmp r0, 0
    jeq fs_no_fd
    store & fs_cluster, r0
    phbp
    call fs_cluster_info
    pobp
    load r7, 0
    ret
fs_no_fd:
    load r7, 4
    ret

; fs_transfer: R2=physical buffer, R3=count (0..255), R4=0 read / 1 write.
; Returns R6=transferred bytes and R7=status. Advances through continuations.
; EOF is a successful short transfer. Writes cannot grow a file. Caller must
; validate user buffers before calling this system-mode routine.
fs_transfer:
    phbp
    store & fs_buffer, r2
    store & fs_count, r3
    store & fs_write, r4
    load r6, 0
    load r0, & fs_head
    cmp r0, 0
    jeq fs_transfer_no_fd
fs_transfer_loop:
    load r0, & fs_count
    cmp r0, 0
    jeq fs_transfer_done
    load r0, & fs_remaining
    cmp r0, 0
    jne fs_transfer_byte
    load r0, & fs_next
    cmp r0, 0
    jeq fs_transfer_done
    store & fs_cluster, r0
    phbp
    call fs_cluster_info
    pobp
    jmp fs_transfer_loop
fs_transfer_byte:
    load r0, & fs_write
    cmp r0, 0
    jne fs_transfer_write
    load r1, & fs_offset
    phbp
    call disk_byte
    pobp
    load r2, & fs_buffer
    ldbp r2
    store & bp + 0, l1
    jmp fs_transfer_advance
fs_transfer_write:
    load r2, & fs_buffer
    ldbp r2
    load l0, & bp + 0
    load r1, & fs_offset
    phbp
    call disk_write_byte
    pobp
fs_transfer_advance:
    load r0, & fs_buffer
    inc r0
    store & fs_buffer, r0
    load r0, & fs_offset
    inc r0
    store & fs_offset, r0
    load r0, & fs_remaining
    dec r0
    store & fs_remaining, r0
    load r0, & fs_count
    dec r0
    store & fs_count, r0
    inc r6
    jmp fs_transfer_loop
fs_transfer_no_fd:
    load r7, 4
    pobp
    ret
fs_transfer_done:
    load r7, 0
    pobp
    ret

; Private filesystem state. Interrupts are masked; no reentrant operations.
fs_head:
    word 0
fs_parent:
    word 0
fs_cluster:
    word 0
fs_base:
    word 0
fs_next:
    word 0
fs_remaining:
    word 0
fs_offset:
    word 0
fs_size:
    word 0
fs_dot:
    word 0
fs_path_cursor:
    word 0
fs_buffer:
    word 0
fs_count:
    word 0
fs_write:
    word 0
fs_path:
    reserve 256
fs_name:
    reserve 20
fs_seen:
    reserve 196

fs_mounted:
    word 0
