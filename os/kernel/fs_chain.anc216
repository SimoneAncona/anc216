; Validated chain traversal and rewind.
; Cluster IDs 1..196 -> offset 2185 + (id-1)*323, using shifts/adds.
; Return in R1, preserve R0/R2 so callers retain the scan state.
fs_cluster_address: ; C: fs_cluster_address: (routine, branch target or data symbol)
    push r0                              ; C: push(r0); | save r0 on the upward-growing stack
    push r2                              ; C: push(r2); | save r2 on the upward-growing stack
    load r0, & fs_cluster                ; C: r0 = *(fs_cluster); | r0 = *(fs_cluster)
    dec r0                               ; C: r0--; | r0--
    tran r1, r0                          ; C: r1 = r0; | r1 = r0
    shl r1, 8                            ; C: r1 <<= 8; | r1 <<= 8
    tran r2, r0                          ; C: r2 = r0; | r2 = r0
    shl r2, 6                            ; C: r2 <<= 6; | r2 <<= 6
    add r1, r2                           ; C: r1 += r2; | r1 += r2
    add r1, r0                           ; C: r1 += r0; | r1 += r0
    shl r0, 1                            ; C: r0 <<= 1; | r0 <<= 1
    add r1, r0                           ; C: r1 += r0; | r1 += r0
    add r1, FS_CLUSTER_OFFSET            ; C: r1 += FS_CLUSTER_OFFSET; | r1 += FS_CLUSTER_OFFSET
    pop r2                               ; C: r2 = pop(); | restore r2 from the stack
    pop r0                               ; C: r0 = pop(); | restore r0 from the stack
    ret                                  ; C: return; // restore CALL PC/SR and discard frame | return through this routine's CALL frame

; Read the current cluster header. Sets data pointer, payload length and next ID.
fs_cluster_info: ; C: fs_cluster_info: (routine, branch target or data symbol)
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call fs_cluster_address              ; C: fs_cluster_address(); | fs_cluster_address()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    store & fs_base, r1                  ; C: *(fs_base) = r1; | *(fs_base) = r1
    load r0, & fs_cluster                ; C: r0 = *(fs_cluster); | r0 = *(fs_cluster)
    cmp r0, & fs_head                    ; C: flags = compare(r0, *(fs_head)); | compare r0 with *(fs_head)
    jne fs_cont_info                     ; C: if (!Z) goto fs_cont_info; | if not equal, goto fs_cont_info
    add r1, FS_NAME_FIELDS               ; C: r1 += FS_NAME_FIELDS; | r1 += FS_NAME_FIELDS
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call disk_byte                       ; C: disk_byte(); | disk_byte()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    store & fs_next, r1                  ; C: *(fs_next) = r1; | *(fs_next) = r1
    load r1, & fs_base                   ; C: r1 = *(fs_base); | r1 = *(fs_base)
    add r1, FS_HEAD_LENGTH               ; C: r1 += FS_HEAD_LENGTH; | r1 += FS_HEAD_LENGTH
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call disk_word                       ; C: disk_word(); | disk_word()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    store & fs_remaining, r1             ; C: *(fs_remaining) = r1; | *(fs_remaining) = r1
    load r1, & fs_base                   ; C: r1 = *(fs_base); | r1 = *(fs_base)
    add r1, FS_HEAD_DATA                 ; C: r1 += FS_HEAD_DATA; | r1 += FS_HEAD_DATA
    store & fs_offset, r1                ; C: *(fs_offset) = r1; | *(fs_offset) = r1
    ret                                  ; C: return; // restore CALL PC/SR and discard frame | return through this routine's CALL frame
fs_cont_info: ; C: fs_cont_info: (routine, branch target or data symbol)
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call disk_byte                       ; C: disk_byte(); | disk_byte()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    store & fs_next, r1                  ; C: *(fs_next) = r1; | *(fs_next) = r1
    load r1, & fs_base                   ; C: r1 = *(fs_base); | r1 = *(fs_base)
    inc r1                               ; C: r1++; | r1++
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call disk_word                       ; C: disk_word(); | disk_word()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    store & fs_remaining, r1             ; C: *(fs_remaining) = r1; | *(fs_remaining) = r1
    load r1, & fs_base                   ; C: r1 = *(fs_base); | r1 = *(fs_base)
    add r1, 3                            ; C: r1 += 3; | r1 += 3
    store & fs_offset, r1                ; C: *(fs_offset) = r1; | *(fs_offset) = r1
    ret                                  ; C: return; // restore CALL PC/SR and discard frame | return through this routine's CALL frame

; Validate the complete file chain before exposing it: IDs/types/parent/length,
; a per-ID bitmap detects cycles. A corrupt chain never becomes a descriptor.
fs_validate: ; C: fs_validate: (routine, branch target or data symbol)
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    load r3, fs_seen                     ; C: r3 = fs_seen; | r3 = fs_seen
    load r4, FS_CLUSTER_COUNT            ; C: r4 = FS_CLUSTER_COUNT; | r4 = FS_CLUSTER_COUNT
fs_seen_clear: ; C: fs_seen_clear: (routine, branch target or data symbol)
    ldbp r3                              ; C: BP = r3; | BP = r3 (physical pointer or saved frame)
    store & bp + 0, byte 0               ; C: *(bp + 0) = 0; | *(bp + 0) = 0
    inc r3                               ; C: r3++; | r3++
    dec r4                               ; C: r4--; | r4--
    jne fs_seen_clear                    ; C: if (!Z) goto fs_seen_clear; | if not equal, goto fs_seen_clear
    store & fs_size, word 0              ; C: *(fs_size) = 0;
    store & fs_allocated, word 0         ; C: *(fs_allocated) = 0;
    load r0, & fs_head                   ; C: r0 = *(fs_head); | r0 = *(fs_head)
    store & fs_cluster, r0               ; C: *(fs_cluster) = r0; | *(fs_cluster) = r0
fs_validate_loop: ; C: fs_validate_loop: (routine, branch target or data symbol)
    load r0, & fs_cluster                ; C: r0 = *(fs_cluster); | r0 = *(fs_cluster)
    cmp r0, 1                            ; C: flags = compare(r0, 1); | compare r0 with 1
    jls fs_corrupt                       ; C: if (N != O) goto fs_corrupt; | if less, goto fs_corrupt
    cmp r0, FS_CLUSTER_COUNT             ; C: flags = compare(r0, FS_CLUSTER_COUNT); | compare r0 with FS_CLUSTER_COUNT
    jgr fs_corrupt                       ; C: if (N == O && !Z) goto fs_corrupt; | if greater, goto fs_corrupt
    tran r3, r0                          ; C: r3 = r0; | r3 = r0
    add r3, fs_seen - 1                  ; C: r3 += fs_seen - 1; | r3 += fs_seen - 1
    ldbp r3                              ; C: BP = r3; | BP = r3 (physical pointer or saved frame)
    load l1, & bp + 0                    ; C: l1 = *(bp + 0); | l1 = *(bp + 0)
    cmp l1, 0                            ; C: flags = compare(l1, 0); | compare l1 with 0
    jne fs_corrupt                       ; C: if (!Z) goto fs_corrupt; | if not equal, goto fs_corrupt
    store & bp + 0, byte 1               ; C: *(bp + 0) = 1; | *(bp + 0) = 1
    tran r1, r0                          ; C: r1 = r0; | r1 = r0
    dec r1                               ; C: r1--; | r1--
    shl r1, 1                            ; C: r1 <<= 1; | r1 <<= 1
    add r1, FS_TABLE_OFFSET              ; C: r1 += FS_TABLE_OFFSET; | r1 += FS_TABLE_OFFSET
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call disk_word                       ; C: disk_word(); | disk_word()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    load r2, & fs_parent                 ; C: r2 = *(fs_parent); | r2 = *(fs_parent)
    shl r2, 8                            ; C: r2 <<= 8; | r2 <<= 8
    load r0, & fs_cluster                ; C: r0 = *(fs_cluster); | r0 = *(fs_cluster)
    cmp r0, & fs_head                    ; C: flags = compare(r0, *(fs_head)); | compare r0 with *(fs_head)
    jne fs_validate_cont                 ; C: if (!Z) goto fs_validate_cont; | if not equal, goto fs_validate_cont
    or r2, 1                             ; C: r2 |= 1; | r2 |= 1
    load r4, FS_HEAD_CAPACITY            ; C: r4 = FS_HEAD_CAPACITY; | r4 = FS_HEAD_CAPACITY
    jmp fs_validate_meta                 ; C: goto fs_validate_meta; | goto fs_validate_meta
fs_validate_cont: ; C: fs_validate_cont: (routine, branch target or data symbol)
    or r2, 2                             ; C: r2 |= 2; | r2 |= 2
    load r4, FS_CONT_CAPACITY            ; C: r4 = FS_CONT_CAPACITY; | r4 = FS_CONT_CAPACITY
fs_validate_meta: ; C: fs_validate_meta: (routine, branch target or data symbol)
    cmp r1, r2                           ; C: flags = compare(r1, r2); | compare r1 with r2
    jne fs_corrupt                       ; C: if (!Z) goto fs_corrupt; | if not equal, goto fs_corrupt
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call fs_cluster_info                 ; C: fs_cluster_info(); | fs_cluster_info()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    load r0, & fs_remaining              ; C: r0 = *(fs_remaining); | r0 = *(fs_remaining)
; Sizes with a high sign bit are necessarily outside 300/320.
    cmp r0, 0                            ; C: flags = compare(r0, 0); | compare r0 with 0
    jls fs_corrupt                       ; C: if (N != O) goto fs_corrupt; | if less, goto fs_corrupt
    cmp r0, r4                           ; C: flags = compare(r0, r4); | compare r0 with r4
    jgr fs_corrupt                       ; C: if (N == O && !Z) goto fs_corrupt; | if greater, goto fs_corrupt
    add r0, & fs_size                    ; C: r0 += *(fs_size); | r0 += *(fs_size)
    trsr l1                              ; C: l1 = SR; | l1 = SR (inspect flags from the preceding operation)
    and l1, 1                            ; C: l1 &= 1; | l1 &= 1
    jne fs_corrupt                       ; C: if (!Z) goto fs_corrupt; | if not equal, goto fs_corrupt
    store & fs_size, r0                  ; C: *(fs_size) = r0;
    load r0, & fs_allocated              ; C: r0 = *(fs_allocated);
    add r0, FS_CLUSTER_BYTES             ; C: r0 += FS_CLUSTER_BYTES;
    store & fs_allocated, r0             ; C: *(fs_allocated) = r0;
    load r0, & fs_next                   ; C: r0 = *(fs_next); | r0 = *(fs_next)
    cmp r0, 0                            ; C: flags = compare(r0, 0); | compare r0 with 0
    jeq fs_valid                         ; C: if (Z) goto fs_valid; | if equal, goto fs_valid
    store & fs_cluster, r0               ; C: *(fs_cluster) = r0; | *(fs_cluster) = r0
    jmp fs_validate_loop                 ; C: goto fs_validate_loop; | goto fs_validate_loop
fs_corrupt: ; C: fs_corrupt: (routine, branch target or data symbol)
    load r7, FS_CORRUPT_CHAIN            ; C: r7 = FS_CORRUPT_CHAIN; | r7 = 5
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    ret                                  ; C: return; // restore CALL PC/SR and discard frame | return through this routine's CALL frame
fs_valid: ; C: fs_valid: (routine, branch target or data symbol)
    load r7, OS_SUCCESS                  ; C: r7 = OS_SUCCESS; | r7 = 0
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    ret                                  ; C: return; // restore CALL PC/SR and discard frame | return through this routine's CALL frame

; Reset sequential position without reparsing the path.
fs_rewind: ; C: fs_rewind: (routine, branch target or data symbol)
    load r0, & fs_head                   ; C: r0 = *(fs_head); | r0 = *(fs_head)
    cmp r0, 0                            ; C: flags = compare(r0, 0); | compare r0 with 0
    jeq fs_no_fd                         ; C: if (Z) goto fs_no_fd; | if equal, goto fs_no_fd
    store & fs_cluster, r0               ; C: *(fs_cluster) = r0; | *(fs_cluster) = r0
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call fs_cluster_info                 ; C: fs_cluster_info(); | fs_cluster_info()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    load r7, OS_SUCCESS                  ; C: r7 = OS_SUCCESS; | r7 = 0
    ret                                  ; C: return; // restore CALL PC/SR and discard frame | return through this routine's CALL frame
fs_no_fd: ; C: fs_no_fd: (routine, branch target or data symbol)
    load r7, FS_NO_DESCRIPTOR            ; C: r7 = FS_NO_DESCRIPTOR; | r7 = 4
    ret                                  ; C: return; // restore CALL PC/SR and discard frame | return through this routine's CALL frame

