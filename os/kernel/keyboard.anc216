; EINR keyboard handler. Hardware saves R0/R1/L2 above its PC/SR frame.
; The separate 3100 interrupt stack avoids overwriting a pending return PC
; when another queued IRQ arrives between POSR and POPC.
; Preserve every remaining register while restoring the interrupt frame. Idle enables I;
; the user loader keeps I masked and getl polls queued keyboard events instead.
; The most recent IRQ payload is exposed at physical IMEM 00f6 for debugging.
keyboard_irq:
    store & irq3, r3
    store & irq4, r4
    store & irq5, r5
    store & irq6, r6
    store & irq7, r7
    cmp r0, 0xfffc
    jne keyboard_irq_return
    store & 0x00f6, r1
    ; No console read is active in idle: consume the event without printing.
    ; getl owns input echo while a program explicitly requests a line.
keyboard_irq_return:
    ; Restore CPU-saved registers, copy PC/SR while still on the system stack.
    pop l2
    pop r1
    pop r0
    load r3, 0
    pop l3
    pop r4
    ldsp & 0x31fe
    ldbp & 0x31fc
    push r4
    push l3
    load r3, & irq3
    load r4, & irq4
    load r5, & irq5
    load r6, & irq6
    load r7, & irq7
    store & 0x7ff0, word 0x000b
    store & 0x7ff2, word 0x0009
    jmp 0x7ff0
irq3:
    word 0
irq4:
    word 0
irq5:
    word 0
irq6:
    word 0
irq7:
    word 0
