; UALf application loader. The filesystem descriptor must already be open.
; A bounded 3584-byte staging area prevents a bad file from overwriting kernel
; memory. Validate the complete header before replacing the current process.
; Supported: version 1, ANC216, type 0 applications, optional symbol records.
; Flags: bit 7 console, bit 5 filesystem; other privilege bits are rejected.
; One foreground process, logical origin zero, no dynamic linking.
exec_open_file:
    phbp
    load r0, & fs_size
    cmp r0, 11
    jls exec_invalid
    cmp r0, 0x0e00
    jgr exec_invalid
    store & exec_size, r0
    phbp
    call fs_rewind
    pobp
    load r2, 0x3200
    store & exec_cursor, r2
exec_read_loop:
    load r0, & exec_size
    cmp r0, 0
    jeq exec_header
    load r3, 255
    cmp r0, 255
    jge exec_read_chunk
    tran r3, r0
exec_read_chunk:
    store & exec_chunk, r3
    load r2, & exec_cursor
    load r4, 0
    phbp
    call fs_transfer
    pobp
    cmp r7, 0
    jne exec_finish
    cmp r6, & exec_chunk
    jne exec_invalid
    load r0, & exec_cursor
    add r0, r6
    store & exec_cursor, r0
    load r0, & exec_size
    sub r0, r6
    store & exec_size, r0
    jmp exec_read_loop
exec_header:
    load r0, & 0x3200
    cmp r0, 0x5541
    jne exec_invalid
    load r0, & 0x3202
    cmp r0, 0x4c01
    jne exec_invalid
    load r0, 0
    load l0, & 0x3206
    cmp r0, 1
    jne exec_invalid
    load l0, & 0x3208
    cmp r0, 0
    jne exec_invalid
    load l0, & 0x3207
    tran r1, r0
    ; Only console (80) and filesystem (20) are implemented permissions.
    and r1, 0x005f
    jne exec_invalid
    store & exec_flags, r0
    load r1, & 0x3209
    cmp r1, 11
    jls exec_invalid
    cmp r1, & fs_size
    jge exec_invalid
    store & exec_header_size, r1
    load r0, & 0x3204
    cmp r0, r1
    jls exec_invalid
    cmp r0, & fs_size
    jge exec_invalid
    sub r0, r1
    add r0, 0x4000
    store & exec_entry, r0
    ; Each optional symbol is a nonempty NUL name followed by two words.
    ; Parsing is bounded by header size; symbols do not require relocation.
    load r2, 11
exec_symbol:
    cmp r2, & exec_header_size
    jeq exec_clear
    tran r3, r2
    add r3, 0x3200
    ldbp r3
    load l0, & bp + 0
    cmp l0, 0
    jeq exec_invalid
exec_symbol_name:
    cmp r2, & exec_header_size
    jge exec_invalid
    tran r3, r2
    add r3, 0x3200
    ldbp r3
    load l0, & bp + 0
    inc r2
    cmp l0, 0
    jne exec_symbol_name
    add r2, 4
    cmp r2, & exec_header_size
    jgr exec_invalid
    jmp exec_symbol
exec_clear:
    ; Previous user data and stack are cleared only after validation succeeds.
    load r2, 0x4000
exec_clear_loop:
    ldbp r2
    store & bp + 0, word 0
    add r2, 2
    cmp r2, 0x8000
    jne exec_clear_loop
    load r2, & exec_header_size
    load r4, & fs_size
    sub r4, r2
    add r2, 0x3200
    load r3, 0x4000
exec_copy:
    ldbp r2
    load l0, & bp + 0
    ldbp r3
    store & bp + 0, l0
    inc r2
    inc r3
    dec r4
    jne exec_copy
    ; Absolute user operands are logical offsets rebased by MTU.
    ; PC/SP/BP stay physical. Privileged IO is mediated by syscalls.
    sili 0x4000
    sihi 0x7fff
    seli 0
    sehi 0
    sbp 0x7800
    stp 0x7fff
    store & fs_head, word 0
    store & process_active, word 1
    load r0, & exec_flags
    store & process_flags, r0
    store & 0x00f0, word 0x2163
    ldsp 0x7800
    ldbp 0x7800
    load r0, & exec_entry
    push r0
    push byte 0
    load r0, 0
    load r1, 0
    load r2, 0
    load r3, 0
    load r4, 0
    load r5, 0
    load r6, 0
    load r7, 0
    ; POSR switches mode; POPC then reads the physical PC from user stack.
    ; Execute the mode switch inside user IMEM: after POSR the next fetch
    ; must already be inside the MTU range. Reinstall before each transition.
    store & 0x7ff0, word 0x000b
    store & 0x7ff2, word 0x0009
    jmp 0x7ff0
exec_invalid:
    load r7, 7
exec_finish:
    pobp
    ret

; Exit/fault discards the interrupt frame and restarts the kernel stack.
process_finish:
    ldsp 0x3000
    ldbp 0x3000
    store & process_active, word 0
    store & fs_head, word 0
    jmp idle
process_active:
    word 0
process_flags:
    word 0
exec_flags:
    word 0
exec_size:
    word 0
exec_cursor:
    word 0
exec_chunk:
    word 0
exec_header_size:
    word 0
exec_entry:
    word 0
