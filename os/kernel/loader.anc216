use SHELL_ARGUMENT_PHYSICAL as 0x7000      ; shell argument physical: 0x7000
use SHELL_ARGUMENT_LOGICAL as 0x3000       ; shell argument logical: 0x3000


; UALf application loader. The filesystem descriptor must already be open.
; Read and validate the header/symbols in bounded scratch memory, then stream
; the payload into user IMEM. Only the payload must fit the user address range.
; Supported: version 1, ANC216, type 0 applications, optional symbol records.
; Flags: bit 7 console, bit 5 filesystem; other privilege bits are rejected.
; One foreground process, logical origin zero, no dynamic linking.
exec_open_file: ; C: exec_open_file: (routine, branch target or data symbol)
    phbp                                 ; C: push(BP);
    load r0, & fs_size
    xor r0, 0x8000                      ; unsigned file size
    cmp r0, 11 + 0x8000
    jls exec_invalid
    phbp
    call fs_rewind
    pobp
    load r2, UAL_STAGING
    load r3, 11
    xor r4, r4
    phbp
    call fs_transfer
    pobp
    cmp r7, 0
    jne exec_finish
    cmp r6, 11
    jne exec_invalid
exec_header: ; C: exec_header: (routine, branch target or data symbol)
    load r0, & UAL_STAGING               ; C: r0 = *(UAL_STAGING);
    cmp r0, UAL_MAGIC_FIRST              ; C: flags = compare(r0, UAL_MAGIC_FIRST);
    jne exec_invalid                     ; C: if (!Z) goto exec_invalid;
    load r0, & UAL_STAGING + 2           ; C: r0 = *(UAL_STAGING + 2);
    cmp r0, UAL_MAGIC_VERSION            ; C: flags = compare(r0, UAL_MAGIC_VERSION);
    jne exec_invalid                     ; C: if (!Z) goto exec_invalid;
    xor r0, r0                           ; C: r0 = 0;
    load l0, & UAL_ARCH_FIELD            ; C: l0 = *(UAL_ARCH_FIELD);
    cmp r0, 1                            ; C: flags = compare(r0, 1);
    jne exec_invalid                     ; C: if (!Z) goto exec_invalid;
    load l0, & UAL_TYPE_FIELD            ; C: l0 = *(UAL_TYPE_FIELD);
    cmp r0, 0                            ; C: flags = compare(r0, 0);
    jne exec_invalid                     ; C: if (!Z) goto exec_invalid;
    load l0, & UAL_FLAGS_FIELD           ; C: l0 = *(UAL_FLAGS_FIELD);
    tran r1, r0                          ; C: r1 = r0;
; Only console (80) and filesystem (20) are implemented permissions.
    and r1, UAL_UNSUPPORTED_FLAGS        ; C: r1 &= UAL_UNSUPPORTED_FLAGS;
    jne exec_invalid                     ; C: if (!Z) goto exec_invalid;
    store & exec_flags, r0               ; C: *(exec_flags) = r0;
    load r1, & UAL_SYMBOL_FIELD          ; file-relative payload start
    tran r0, r1
    xor r0, 0x8000
    cmp r0, 11 + 0x8000
    jls exec_invalid
    load r2, & fs_size
    xor r2, 0x8000
    cmp r0, r2
    jge exec_invalid                     ; payload must be nonempty
    store & exec_header_size, r1
    load r0, & fs_size
    sub r0, r1
    store & exec_size, r0                ; payload bytes remaining
    xor r0, 0x8000
    cmp r0, USER_LIMIT - USER_BASE + 1 - 0x8000
    jgr exec_invalid                     ; inclusive full user IMEM capacity
    load r0, & UAL_ENTRY_FIELD
    tran r2, r0
    xor r2, 0x8000
    xor r1, 0x8000
    cmp r2, r1
    jls exec_invalid
    load r3, & fs_size
    xor r3, 0x8000
    cmp r2, r3
    jge exec_invalid
    load r1, & exec_header_size
    sub r0, r1
    add r0, USER_BASE
    store & exec_entry, r0
; Optional symbols: nonempty NUL name followed by two words. Stream through
; scratch so header size does not impose a second executable-size limit.
    sub r1, 11
    store & exec_symbol_remaining, r1
exec_symbol:
    load r0, & exec_symbol_remaining
    cmp r0, 0
    jeq exec_clear
    phbp
    call exec_symbol_byte
    pobp
    cmp r7, 0
    jne exec_finish
    cmp l0, 0
    jeq exec_invalid                     ; empty symbol name
exec_symbol_name:
    phbp
    call exec_symbol_byte
    pobp
    cmp r7, 0
    jne exec_finish
    cmp l0, 0
    jne exec_symbol_name
    load r0, & exec_symbol_remaining
    xor r0, 0x8000
    cmp r0, 4 + 0x8000
    jls exec_invalid
    load r2, UAL_STAGING + 11
    load r3, 4
    xor r4, r4
    phbp
    call fs_transfer
    pobp
    cmp r7, 0
    jne exec_finish
    cmp r6, 4
    jne exec_invalid
    load r0, & exec_symbol_remaining
    sub r0, 4
    store & exec_symbol_remaining, r0
    jmp exec_symbol
exec_clear: ; C: exec_clear: (routine, branch target or data symbol)
; Previous user data and stack are cleared only after validation succeeds.
    load r2, USER_BASE                   ; C: r2 = USER_BASE;
exec_clear_loop: ; C: exec_clear_loop: (routine, branch target or data symbol)
    ldbp r2                              ; C: BP = r2;
    store & bp + 0, word 0               ; C: *(bp + 0) = 0;
    add r2, 2                            ; C: r2 += 2;
    cmp r2, USER_END                     ; C: flags = compare(r2, USER_END);
    jne exec_clear_loop                  ; C: if (!Z) goto exec_clear_loop;
    load r0, USER_BASE
    store & exec_cursor, r0
exec_read_loop:
    load r0, & exec_size
    cmp r0, 0
    jeq exec_loaded
    xor r0, 0x8000
    load r3, 255
    cmp r0, 255 + 0x8000
    jge exec_read_chunk
    load r3, & exec_size
exec_read_chunk:
    store & exec_chunk, r3
    load r2, & exec_cursor
    xor r4, r4
    phbp
    call fs_transfer
    pobp
    cmp r7, 0
    jne panic                           ; validated chain failed after replacement began
    cmp r6, & exec_chunk
    jne panic
    load r0, & exec_cursor
    add r0, r6
    store & exec_cursor, r0
    load r0, & exec_size
    sub r0, r6
    store & exec_size, r0
    jmp exec_read_loop
exec_loaded:
; Absolute user operands are logical offsets rebased by MTU.
; User PC/SP/BP are logical. Privileged IO is mediated by syscalls.
    sili USER_BASE                       ; C: MTU.imem_lower = USER_BASE;
    sihi USER_LIMIT                      ; C: MTU.imem_upper = USER_LIMIT;
    seli EMEM_DENY_LOWER                 ; C: MTU.emem_lower = EMEM_DENY_LOWER; | empty interval denies all user device access
    sehi EMEM_DENY_UPPER                 ; C: MTU.emem_upper = EMEM_DENY_UPPER;
    sbp USER_STACK_PHYSICAL              ; stack bounds remain physical
    stp USER_LIMIT                       ; C: MTU.stack_top = USER_LIMIT;
    store & fs_head, word 0              ; C: *(fs_head) = 0;
    store & process_active, word 1       ; C: *(process_active) = 1;
    load r0, & exec_flags                ; C: r0 = *(exec_flags);
    store & process_flags, r0            ; C: *(process_flags) = r0;
    store & STATE_ADDRESS, word STATE_RUNNING ; C: *(STATE_ADDRESS) = STATE_RUNNING;
    ldsp USER_STACK_PHYSICAL             ; launch frame is constructed in system mode
    ldbp USER_STACK_PHYSICAL             ; POSR converts SP/BP to logical user offsets
    load r0, & exec_entry                ; loader entry is physical
    sub r0, USER_BASE                    ; POPC expects a logical user PC
    push r0                              ; C: push(r0);
    push byte 0                          ; C: push(0);
; Only run(1a) requests an argument handoff and shell restart on exit.
    load r0, & shell_launch_pending      ; C: r0 = *(shell_launch_pending);
    store & shell_return_pending, r0     ; C: *(shell_return_pending) = r0;
    store & shell_launch_pending, word 0 ; C: *(shell_launch_pending) = 0;
    cmp r0, 0                            ; C: flags = compare(r0, 0);
    jeq exec_no_arguments                ; C: if (Z) goto exec_no_arguments;
    load r4, shell_arguments             ; C: r4 = shell_arguments;
    load r3, SHELL_ARGUMENT_PHYSICAL     ; C: r3 = SHELL_ARGUMENT_PHYSICAL;
    load r5, & shell_argument_length     ; C: r5 = *(shell_argument_length);
    phbp                                 ; C: push(BP);
    call shell_copy_bytes                ; C: shell_copy_bytes();
    pobp                                 ; C: BP = pop_word();
    load r3, SHELL_ARGUMENT_PHYSICAL     ; C: r3 = SHELL_ARGUMENT_PHYSICAL;
    add r3, & shell_argument_length      ; C: r3 += *(shell_argument_length);
    phbp                                 ; C: push(BP);
    ldbp r3                              ; C: BP = r3;
    store & bp + 0, byte 0               ; C: *(bp + 0) = 0;
    pobp                                 ; C: BP = pop_word();
exec_no_arguments: ; C: exec_no_arguments: (routine, branch target or data symbol)
; Loading is complete; command file handles refer to the session data volume.
    load r1, & shell_session_device      ; C: r1 = *(shell_session_device);
    phbp                                 ; C: push(BP);
    call fs_mount                        ; C: fs_mount();
    pobp                                 ; C: BP = pop_word();
    xor r0, r0                           ; C: r0 = 0;
    load r1, SHELL_ARGUMENT_LOGICAL      ; C: r1 = SHELL_ARGUMENT_LOGICAL;
    load r2, & shell_argument_length     ; C: r2 = *(shell_argument_length);
    xor r3, r3                           ; C: r3 = 0;
    xor r4, r4                           ; C: r4 = 0;
    xor r5, r5                           ; C: r5 = 0;
    xor r6, r6                           ; C: r6 = 0;
    xor r7, r7                  ; C: r7 = OS_SUCCESS;
; POSR converts PC/SP/BP to user offsets; POPC reads the logical entry PC.
; Execute the mode switch inside user IMEM: after POSR the next fetch
; must already be inside the MTU range. Reinstall before each transition.
    store & RETURN_STUB, word RETURN_POSR_WORD ; C: *(RETURN_STUB) = RETURN_POSR_WORD;
    store & RETURN_STUB_PC, word RETURN_POPC_WORD ; C: *(RETURN_STUB_PC) = RETURN_POPC_WORD;
    jmp RETURN_STUB                      ; C: goto RETURN_STUB;
; Read one optional-symbol byte without touching the current user image.
exec_symbol_byte:
    load r0, & exec_symbol_remaining
    cmp r0, 0
    jeq exec_symbol_byte_invalid
    load r2, UAL_STAGING + 11
    load r3, 1
    xor r4, r4
    phbp
    call fs_transfer
    pobp
    cmp r7, 0
    jne exec_symbol_byte_return
    cmp r6, 1
    jne exec_symbol_byte_invalid
    load r0, & exec_symbol_remaining
    dec r0
    store & exec_symbol_remaining, r0
    xor r0, r0
    load l0, & UAL_STAGING + 11
exec_symbol_byte_return:
    ret
exec_symbol_byte_invalid:
    load r7, OS_BAD_EXEC
    ret
exec_invalid: ; C: exec_invalid: (routine, branch target or data symbol)
    load r7, OS_BAD_EXEC                 ; C: r7 = OS_BAD_EXEC;
exec_finish: ; C: exec_finish: (routine, branch target or data symbol)
    pobp                                 ; C: BP = pop_word();
    ret                                  ; C: return; // restore CALL PC/SR and discard frame

; Exit/fault discards the interrupt frame and restarts the kernel stack.
process_finish: ; C: process_finish: (routine, branch target or data symbol)
    ldsp KERNEL_STACK                    ; C: SP = KERNEL_STACK;
    ldbp KERNEL_STACK                    ; C: BP = KERNEL_STACK;
    store & process_active, word 0       ; C: *(process_active) = 0;
    store & fs_head, word 0              ; C: *(fs_head) = 0;
    load r0, & shell_return_pending      ; C: r0 = *(shell_return_pending);
    cmp r0, 0                            ; C: flags = compare(r0, 0);
    jne shell_restart                    ; C: if (!Z) goto shell_restart;
    jmp idle                             ; C: goto idle;
process_active: ; C: process_active: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
process_flags: ; C: process_flags: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
exec_flags: ; C: exec_flags: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
exec_size: ; C: exec_size: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
exec_cursor: ; C: exec_cursor: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
exec_chunk: ; C: exec_chunk: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
exec_header_size: ; C: exec_header_size: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
exec_entry: ; C: exec_entry: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };

exec_symbol_remaining:
    word 0
