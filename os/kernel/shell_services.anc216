; Shell support stays in kernel syscalls; commands are separate UALf programs.
use SHELL_PATH_CAPACITY as 255
use SHELL_ENTRY_BYTES as 24

; _______________________________________________________________________
; Shared path validation for namespace syscalls: arguments R1 path/R2 length.
; user_buffer turns the logical address into a checked physical kernel pointer.
syscall_namespace_path:
    load r1, & arg1                      ; r1 = *(arg1)
    load r2, & arg2                      ; r2 = *(arg2)
    and r2, 0xff                         ; r2 &= 0xff
    phbp                                 ; save BP before pointer/helper use
    call user_buffer                     ; user_buffer()
    pobp                                 ; restore the saved BP
    ret                                  ; return through this routine's CALL frame
syscall_directory:
    phbp                                 ; save BP before pointer/helper use
    call syscall_namespace_path          ; syscall_namespace_path()
    pobp                                 ; restore the saved BP
    cmp r7, FS_SUCCESS                   ; compare r7 with FS_SUCCESS
    jne syscall_return                   ; if not equal, goto syscall_return
    phbp                                 ; save BP before pointer/helper use
    call fs_directory                    ; fs_directory()
    pobp                                 ; restore the saved BP
    jmp syscall_return                   ; goto syscall_return
syscall_list:
    load r1, & arg3                      ; output record must fit before the return stub
    load r2, SHELL_ENTRY_BYTES           ; r2 = SHELL_ENTRY_BYTES
    phbp                                 ; save BP before pointer/helper use
    call user_buffer                     ; user_buffer()
    pobp                                 ; restore the saved BP
    cmp r7, FS_SUCCESS                   ; compare r7 with FS_SUCCESS
    jne syscall_return                   ; if not equal, goto syscall_return
    store & shell_entry_pointer, r1      ; *(shell_entry_pointer) = r1
    phbp                                 ; save BP before pointer/helper use
    call syscall_namespace_path          ; syscall_namespace_path()
    pobp                                 ; restore the saved BP
    cmp r7, FS_SUCCESS                   ; compare r7 with FS_SUCCESS
    jne syscall_return                   ; if not equal, goto syscall_return
    load r3, & shell_entry_pointer       ; r3 = *(shell_entry_pointer)
    load r4, & arg4                      ; combined directory/file cursor, zero starts
    phbp                                 ; save BP before pointer/helper use
    call fs_list                         ; fs_list()
    pobp                                 ; restore the saved BP
    jmp syscall_return                   ; goto syscall_return
syscall_touch:
    phbp                                 ; save BP before pointer/helper use
    call syscall_namespace_path          ; syscall_namespace_path()
    pobp                                 ; restore the saved BP
    cmp r7, FS_SUCCESS                   ; compare r7 with FS_SUCCESS
    jne syscall_return                   ; if not equal, goto syscall_return
    phbp                                 ; save BP before pointer/helper use
    call fs_touch                        ; fs_touch()
    pobp                                 ; restore the saved BP
    jmp syscall_return                   ; goto syscall_return
syscall_mkdir:
    phbp                                 ; save BP before pointer/helper use
    call syscall_namespace_path          ; syscall_namespace_path()
    pobp                                 ; restore the saved BP
    cmp r7, FS_SUCCESS                   ; compare r7 with FS_SUCCESS
    jne syscall_return                   ; if not equal, goto syscall_return
    phbp                                 ; save BP before pointer/helper use
    call fs_mkdir                        ; fs_mkdir()
    pobp                                 ; restore the saved BP
    jmp syscall_return                   ; goto syscall_return
syscall_remove:
    phbp                                 ; save BP before pointer/helper use
    call syscall_namespace_path          ; syscall_namespace_path()
    pobp                                 ; restore the saved BP
    cmp r7, FS_SUCCESS                   ; compare r7 with FS_SUCCESS
    jne syscall_return                   ; if not equal, goto syscall_return
    phbp                                 ; save BP before pointer/helper use
    call fs_remove                       ; fs_remove()
    pobp                                 ; restore the saved BP
    jmp syscall_return                   ; goto syscall_return

; _______________________________________________________________________
; clear(07) requires console permission. Clear pixels and reset text coordinates.
syscall_clear:
    load r0, & process_flags             ; r0 = *(process_flags)
    and r0, 0x80                         ; r0 &= 0x80
    jeq syscall_denied                   ; if equal, goto syscall_denied
    write & 0xfffd, word 0x0200
    store & console_x, word 0            ; *(console_x) = 0
    store & console_y, word 0            ; *(console_y) = 0
    jmp syscall_return                   ; goto syscall_return

; _______________________________________________________________________
; getcwd(1b): R1 buffer/R2 capacity; R6 bytes excluding NUL.
; chdir(1c): R1 normalized absolute path/R2 length; require an existing directory.
; Cwd belongs to the session, so it survives command executable replacement.
syscall_getcwd:
    load r1, & arg1                      ; r1 = *(arg1)
    load r2, & arg2                      ; r2 = *(arg2)
    cmp r2, & shell_cwd_length           ; compare r2 with *(shell_cwd_length)
    jle syscall_invalid                  ; capacity includes the trailing NUL
    phbp                                 ; save BP before pointer/helper use
    call user_buffer                     ; user_buffer()
    pobp                                 ; restore the saved BP
    cmp r7, FS_SUCCESS                   ; compare r7 with FS_SUCCESS
    jne syscall_return                   ; if not equal, goto syscall_return
    tran r3, r1                          ; r3 = r1
    load r4, shell_cwd                   ; r4 = shell_cwd
    load r5, & shell_cwd_length          ; r5 = *(shell_cwd_length)
    inc r5                               ; r5++
    phbp                                 ; save BP before pointer/helper use
    call shell_copy_bytes                ; shell_copy_bytes()
    pobp                                 ; restore the saved BP
    load r6, & shell_cwd_length          ; r6 = *(shell_cwd_length)
    jmp syscall_return                   ; goto syscall_return
syscall_chdir:
    phbp                                 ; save BP before pointer/helper use
    call syscall_namespace_path          ; syscall_namespace_path()
    pobp                                 ; restore the saved BP
    cmp r7, FS_SUCCESS                   ; compare r7 with FS_SUCCESS
    jne syscall_return                   ; if not equal, goto syscall_return
    phbp                                 ; save BP before pointer/helper use
    call fs_directory                    ; fs_directory()
    pobp                                 ; restore the saved BP
    cmp r7, FS_SUCCESS                   ; compare r7 with FS_SUCCESS
    jne syscall_return                   ; if not equal, goto syscall_return
    load r1, & arg1                      ; r1 = *(arg1)
    add r1, 0x4000                       ; r1 += 0x4000
    tran r4, r1                          ; r4 = r1
    load r3, shell_cwd                   ; r3 = shell_cwd
    load r5, & arg2                      ; r5 = *(arg2)
    and r5, 0xff                         ; r5 &= 0xff
    store & shell_cwd_length, r5         ; *(shell_cwd_length) = r5
    phbp                                 ; save BP before pointer/helper use
    call shell_copy_bytes                ; shell_copy_bytes()
    pobp                                 ; restore the saved BP
    load r3, shell_cwd                   ; r3 = shell_cwd
    add r3, & shell_cwd_length           ; r3 += *(shell_cwd_length)
    phbp                                 ; save BP before pointer/helper use
    ldbp r3                              ; BP = r3 (physical pointer or saved frame)
    store & bp + 0, byte 0               ; *(bp + 0) = 0
    pobp                                 ; restore the saved BP
    jmp syscall_return                   ; goto syscall_return

; _______________________________________________________________________
; run(1a): R1 executable/R2 path length, R3 arguments/R4 argument length.
; Save arguments in kernel memory before exec clears the old user's IMEM.
; On successful launch the command receives R1=3000/R2=length; exit/fault
; reloads /bin/init. Failed validation leaves the invoking shell alive.
syscall_run:
    load r1, & arg3                      ; r1 = *(arg3)
    load r2, & arg4                      ; r2 = *(arg4)
    cmp r2, SHELL_PATH_CAPACITY          ; compare r2 with SHELL_PATH_CAPACITY
    jge syscall_invalid                  ; if greater or equal, goto syscall_invalid
    phbp                                 ; save BP before pointer/helper use
    call user_buffer                     ; user_buffer()
    pobp                                 ; restore the saved BP
    cmp r7, FS_SUCCESS                   ; compare r7 with FS_SUCCESS
    jne syscall_return                   ; if not equal, goto syscall_return
    tran r4, r1                          ; r4 = r1
    load r3, shell_arguments             ; r3 = shell_arguments
    tran r5, r2                          ; r5 = r2
    store & shell_argument_length, r2    ; *(shell_argument_length) = r2
    phbp                                 ; save BP before pointer/helper use
    call shell_copy_bytes                ; shell_copy_bytes()
    pobp                                 ; restore the saved BP
    load r1, 0x0200                      ; executable lookup always uses the boot volume
    phbp                                 ; save BP before pointer/helper use
    call fs_mount                        ; fs_mount()
    pobp                                 ; restore the saved BP
    cmp r7, FS_SUCCESS                   ; compare r7 with FS_SUCCESS
    jne shell_launch_error               ; if not equal, goto shell_launch_error
    phbp                                 ; save BP before pointer/helper use
    call syscall_namespace_path          ; syscall_namespace_path()
    pobp                                 ; restore the saved BP
    cmp r7, FS_SUCCESS                   ; compare r7 with FS_SUCCESS
    jne shell_launch_error               ; if not equal, goto shell_launch_error
    phbp                                 ; save BP before pointer/helper use
    call fs_open                         ; fs_open()
    pobp                                 ; restore the saved BP
    cmp r7, FS_SUCCESS                   ; compare r7 with FS_SUCCESS
    jne shell_launch_error               ; if not equal, goto shell_launch_error
    store & shell_launch_pending, word 1 ; *(shell_launch_pending) = 1
    phbp                                 ; save BP before pointer/helper use
    call exec_open_file                  ; exec_open_file()
    pobp                                 ; restore the saved BP
shell_launch_error:
    push r7                              ; restore the data volume even on launch failure
    load r1, & shell_session_device      ; r1 = *(shell_session_device)
    phbp                                 ; save BP before pointer/helper use
    call fs_mount                        ; fs_mount()
    pobp                                 ; restore the saved BP
    pop r7                               ; restore r7 from the stack
    store & shell_launch_pending, word 0 ; *(shell_launch_pending) = 0
    store & shell_argument_length, word 0 ; *(shell_argument_length) = 0
    jmp syscall_return                   ; goto syscall_return

; R4 source/R3 destination/R5 byte count, physical addresses. Zero count is safe.
shell_copy_bytes:
    phbp                                 ; save BP before pointer/helper use
shell_copy_loop:
    cmp r5, 0                            ; compare r5 with 0
    jeq shell_copy_done                  ; if equal, goto shell_copy_done
    ldbp r4                              ; BP = r4 (physical pointer or saved frame)
    load l0, & bp + 0                    ; l0 = *(bp + 0)
    ldbp r3                              ; BP = r3 (physical pointer or saved frame)
    store & bp + 0, l0                   ; *(bp + 0) = l0
    inc r4                               ; r4++
    inc r3                               ; r3++
    dec r5                               ; r5--
    jmp shell_copy_loop                  ; goto shell_copy_loop
shell_copy_done:
    pobp                                 ; restore the saved BP
    ret                                  ; return through this routine's CALL frame

; Reload init without clearing the screen or cwd. The boot volume is explicit;
; a command may have mounted another chip, but init lives on the boot chip.
shell_restart:
    store & shell_return_pending, word 0 ; *(shell_return_pending) = 0
    store & shell_launch_pending, word 0 ; *(shell_launch_pending) = 0
    store & shell_argument_length, word 0 ; *(shell_argument_length) = 0
    load r1, 0x0200                      ; r1 = 0x0200
    phbp                                 ; save BP before pointer/helper use
    call fs_mount                        ; fs_mount()
    pobp                                 ; restore the saved BP
    cmp r7, FS_SUCCESS                   ; compare r7 with FS_SUCCESS
    jne idle                             ; if not equal, goto idle
    load r1, init_path                   ; r1 = init_path
    load r2, sizeof init_path            ; r2 = sizeof init_path
    phbp                                 ; save BP before pointer/helper use
    call fs_open                         ; fs_open()
    pobp                                 ; restore the saved BP
    cmp r7, FS_SUCCESS                   ; compare r7 with FS_SUCCESS
    jne idle                             ; if not equal, goto idle
    phbp                                 ; save BP before pointer/helper use
    call exec_open_file                  ; exec_open_file()
    pobp                                 ; restore the saved BP
    jmp idle                             ; invalid/missing init leaves a quiet kernel
shell_entry_pointer:
    word 0
shell_launch_pending:
    word 0
shell_return_pending:
    word 0
shell_argument_length:
    word 0
shell_arguments:
    reserve SHELL_PATH_CAPACITY
shell_cwd_length:
    word 1
shell_cwd:
    "/", byte 0
    reserve SHELL_PATH_CAPACITY - 2
shell_session_device:
    word 0x0200
