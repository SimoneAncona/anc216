; Checked console output and blocking line input.
; print(05): R1 buffer, L2 count, R3 stream 0/1. Requires console flag 80.
; Length is authoritative, so this service never scans an unbounded string.
syscall_print: ; C: syscall_print: (routine, branch target or data symbol)
    load r0, & process_flags             ; C: r0 = *(process_flags);
    and r0, PERMISSION_CONSOLE           ; C: r0 &= PERMISSION_CONSOLE;
    jeq syscall_denied                   ; C: if (Z) goto syscall_denied;
    load r0, & arg3                      ; C: r0 = *(arg3);
    cmp r0, 0                            ; C: flags = compare(r0, 0);
    jls syscall_invalid                  ; C: if (N != O) goto syscall_invalid;
    cmp r0, 1                            ; C: flags = compare(r0, 1);
    jgr syscall_invalid                  ; C: if (N == O && !Z) goto syscall_invalid;
    load r1, & arg1                      ; C: r1 = *(arg1);
    load r2, & arg2                      ; C: r2 = *(arg2);
    and r2, BYTE_MASK                    ; C: r2 &= BYTE_MASK;
    phbp                                 ; C: push(BP);
    call user_buffer                     ; C: user_buffer();
    pobp                                 ; C: BP = pop_word();
    cmp r7, 0                            ; C: flags = compare(r7, 0);
    jne syscall_return                   ; C: if (!Z) goto syscall_return;
    store & print_pointer, r1            ; C: *(print_pointer) = r1;
    store & print_count, r2              ; C: *(print_count) = r2;
syscall_print_loop: ; C: syscall_print_loop: (routine, branch target or data symbol)
    load r0, & print_count               ; C: r0 = *(print_count);
    cmp r0, 0                            ; C: flags = compare(r0, 0);
    jeq syscall_print_done               ; C: if (Z) goto syscall_print_done;
    load r2, & print_pointer             ; C: r2 = *(print_pointer);
    phbp                                 ; C: push(BP);
    ldbp r2                              ; C: BP = r2;
    load l0, & bp + 0                    ; C: l0 = *(bp + 0);
    phbp                                 ; C: push(BP);
    call putc                            ; C: putc();
    pobp                                 ; C: BP = pop_word();
    pobp                                 ; C: BP = pop_word();
    load r0, & print_pointer             ; C: r0 = *(print_pointer);
    inc r0                               ; C: r0++;
    store & print_pointer, r0            ; C: *(print_pointer) = r0;
    load r0, & print_count               ; C: r0 = *(print_count);
    dec r0                               ; C: r0--;
    store & print_count, r0              ; C: *(print_count) = r0;
    jmp syscall_print_loop               ; C: goto syscall_print_loop;
syscall_print_done: ; C: syscall_print_done: (routine, branch target or data symbol)
    load r6, & arg2                      ; C: r6 = *(arg2);
    and r6, BYTE_MASK                    ; C: r6 &= BYTE_MASK;
    load r7, OS_SUCCESS                  ; C: r7 = OS_SUCCESS;
    jmp syscall_return                   ; C: goto syscall_return;

; Check if the keyboard is reachable, this is a routine, can be called
syscall_check_kbd_device:
    ireq & KEYBOARD_ADDRESS              ; C: (r0, r1) = device_identify(KEYBOARD_ADDRESS);
    cmp r0, KEYBOARD_ID                  ; C: flags = compare(r0, KEYBOARD_ID);
    jeq syscall_check_kbd_device_next    ; C: if (Z) goto syscall_check_kbd_device_next;
    load r7, FS_BAD_DEVICE               ; C: r7 = FS_BAD_DEVICE;
    jmp syscall_return                   ; C: goto syscall_return;
syscall_check_kbd_device_next:
    ret


; getl(06): R1 capacity (1..255), R2 logical destination.
; Requires console permission. Poll keyboard while I is masked, so SDL capture
; can continue without nesting interrupts into the system-call stack.
; R6 is the length excluding newline/NUL; capacity includes the NUL terminator.
; Enter finishes, backspace erases one buffered byte; unknown keys are ignored.
syscall_getl: ; C: syscall_getl: (routine, branch target or data symbol)
    call syscall_check_kbd_device
    load r0, & process_flags             ; C: r0 = *(process_flags);
    and r0, PERMISSION_CONSOLE           ; C: r0 &= PERMISSION_CONSOLE;
    jeq syscall_denied                   ; C: if (Z) goto syscall_denied;
    load r2, & arg1                      ; C: r2 = *(arg1);
    cmp r2, 1                            ; C: flags = compare(r2, 1);
    jls syscall_invalid                  ; C: if (N != O) goto syscall_invalid;
    load r1, & arg2                      ; C: r1 = *(arg2);
    phbp                                 ; C: push(BP);
    call user_buffer                     ; C: user_buffer();
    pobp                                 ; C: BP = pop_word();
    cmp r7, 0                            ; C: flags = compare(r7, 0);
    jne syscall_return                   ; C: if (!Z) goto syscall_return;
    store & input_start, r1              ; C: *(input_start) = r1;
    store & input_pointer, r1            ; C: *(input_pointer) = r1;
    dec r2                               ; C: r2--;
    store & input_capacity, r2           ; C: *(input_capacity) = r2;
    store & input_length, word 0         ; C: *(input_length) = 0;
    phbp                                 ; C: push(BP);
    call console_cursor_reset            ; C: console_cursor_reset();
    pobp                                 ; C: BP = pop_word();
syscall_getl_loop: ; C: syscall_getl_loop: (routine, branch target or data symbol)
    phbp                                 ; C: push(BP);
    call console_cursor_tick             ; C: console_cursor_tick(); | blink even when the input queue is empty
    pobp                                 ; C: BP = pop_word();
    load r1, 0                           ; C: r1 = 0;
    read & KEYBOARD_ADDRESS              ; C: r1 = device_read(KEYBOARD_ADDRESS, r1);
    cmp r1, 0                            ; C: flags = compare(r1, 0);
    jeq syscall_getl_loop                ; C: if (Z) goto syscall_getl_loop;
    store & input_event, r1              ; C: *(input_event) = r1; | drawing uses R1 for GPU reads
    cmp r1, 10                           ; C: flags = compare(r1, 10);
    jeq syscall_getl_done                ; C: if (Z) goto syscall_getl_done;
    cmp r1, 8                            ; C: flags = compare(r1, 8);
    jeq syscall_getl_backspace           ; C: if (Z) goto syscall_getl_backspace;
    cmp r1, 32                           ; C: flags = compare(r1, 32);
    jls syscall_getl_loop                ; C: if (N != O) goto syscall_getl_loop;
    cmp r1, 126                          ; C: flags = compare(r1, 126);
    jgr syscall_getl_loop                ; C: if (N == O && !Z) goto syscall_getl_loop;
    load r0, & input_length              ; C: r0 = *(input_length);
    cmp r0, & input_capacity             ; C: flags = compare(r0, *(input_capacity));
    jge syscall_getl_loop                ; C: if (N == O) goto syscall_getl_loop;
    phbp                                 ; C: push(BP);
    call console_cursor_hide             ; C: console_cursor_hide();
    pobp                                 ; C: BP = pop_word();
; Remember the actual cell, including line wraps, for visual backspace.
    load r2, & input_length              ; C: r2 = *(input_length);
    shl r2, 1                            ; C: r2 <<= 1;
    add r2, input_coordinates            ; C: r2 += input_coordinates;
    load r0, & console_x                 ; C: r0 = *(console_x);
    shl r0, 8                            ; C: r0 <<= 8;
    or r0, & console_y                   ; C: r0 |= *(console_y);
    phbp                                 ; C: push(BP);
    ldbp r2                              ; C: BP = r2;
    store & bp + 0, r0                   ; C: *(bp + 0) = r0;
    pobp                                 ; C: BP = pop_word();
    load r0, & input_length              ; C: r0 = *(input_length);
    load r1, & input_event               ; C: r1 = *(input_event);
    phbp                                 ; C: push(BP);
    load r2, & input_pointer             ; C: r2 = *(input_pointer);
    ldbp r2                              ; C: BP = r2;
    store & bp + 0, l1                   ; C: *(bp + 0) = l1;
    pobp                                 ; C: BP = pop_word();
    inc r2                               ; C: r2++;
    store & input_pointer, r2            ; C: *(input_pointer) = r2;
    inc r0                               ; C: r0++;
    store & input_length, r0             ; C: *(input_length) = r0;
    tran r0, r1                          ; C: r0 = r1;
    phbp                                 ; C: push(BP);
    call putc                            ; C: putc();
    pobp                                 ; C: BP = pop_word();
    phbp                                 ; C: push(BP);
    call console_cursor_reset            ; C: console_cursor_reset();
    pobp                                 ; C: BP = pop_word();
    jmp syscall_getl_loop                ; C: goto syscall_getl_loop;
syscall_getl_backspace: ; C: syscall_getl_backspace: (routine, branch target or data symbol)
    load r0, & input_length              ; C: r0 = *(input_length);
    cmp r0, 0                            ; C: flags = compare(r0, 0);
    jeq syscall_getl_loop                ; C: if (Z) goto syscall_getl_loop;
    phbp                                 ; C: push(BP);
    call console_cursor_hide             ; C: console_cursor_hide();
    pobp                                 ; C: BP = pop_word();
    load r0, & input_length              ; C: r0 = *(input_length);
    dec r0                               ; C: r0--;
    store & input_length, r0             ; C: *(input_length) = r0;
    shl r0, 1                            ; C: r0 <<= 1;
    add r0, input_coordinates            ; C: r0 += input_coordinates;
    phbp                                 ; C: push(BP);
    ldbp r0                              ; C: BP = r0;
    load r3, & bp + 0                    ; C: r3 = *(bp + 0); | high byte X, low byte Y of the deleted glyph
    pobp                                 ; C: BP = pop_word();
    tran r0, r3                          ; C: r0 = r3;
    shr r0, 8                            ; C: r0 >>= 8;
    store & console_x, r0                ; C: *(console_x) = r0;
    and r3, BYTE_MASK                    ; C: r3 &= BYTE_MASK;
    store & console_y, r3                ; C: *(console_y) = r3;
    load r0, & input_pointer             ; C: r0 = *(input_pointer);
    dec r0                               ; C: r0--;
    store & input_pointer, r0            ; C: *(input_pointer) = r0;
    phbp                                 ; C: push(BP);
    ldbp r0                              ; C: BP = r0;
    store & bp + 0, byte 0               ; C: *(bp + 0) = 0; | remove the byte as well as its visible glyph
    pobp                                 ; C: BP = pop_word();
    phbp                                 ; C: push(BP);
    call console_erase_cell              ; C: console_erase_cell();
    pobp                                 ; C: BP = pop_word();
    phbp                                 ; C: push(BP);
    call console_cursor_reset            ; C: console_cursor_reset();
    pobp                                 ; C: BP = pop_word();
    jmp syscall_getl_loop                ; C: goto syscall_getl_loop;
syscall_getl_done: ; C: syscall_getl_done: (routine, branch target or data symbol)
    phbp                                 ; C: push(BP);
    call console_cursor_hide             ; C: console_cursor_hide(); | no cursor remains after Enter returns the line
    pobp                                 ; C: BP = pop_word();
    tstop                                ; C: timer_running = false;
    phbp                                 ; C: push(BP);
    load r2, & input_pointer             ; C: r2 = *(input_pointer);
    ldbp r2                              ; C: BP = r2;
    store & bp + 0, byte 0               ; C: *(bp + 0) = 0;
    pobp                                 ; C: BP = pop_word();
    load r0, 10                          ; C: r0 = 10;
    phbp                                 ; C: push(BP);
    call putc                            ; C: putc();
    pobp                                 ; C: BP = pop_word();
    load r6, & input_length              ; C: r6 = *(input_length);
    load r7, OS_SUCCESS                  ; C: r7 = OS_SUCCESS;
    jmp syscall_return                   ; C: goto syscall_return;

; getk(): Get single key press from the keyboard
; R6 =
syscall_getk:
    call syscall_check_kbd_device
    load r0, & process_flags             ; C: r0 = *(process_flags);
    and r0, PERMISSION_CONSOLE           ; C: r0 &= PERMISSION_CONSOLE;
    jeq syscall_denied                   ; C: if (Z) goto syscall_denied;
syscall_getk_loop:
    load r1, 0                           ; select and consume the next keyboard event
    read & KEYBOARD_ADDRESS
    cmp r1, 0
    jeq syscall_getk_loop
    tran r6, r1
    load r7, OS_SUCCESS
    jmp syscall_return


print_pointer: ; C: print_pointer: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
print_count: ; C: print_count: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
input_start: ; C: input_start: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
input_pointer: ; C: input_pointer: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
input_capacity: ; C: input_capacity: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
input_length: ; C: input_length: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };

input_event: ; C: input_event: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
input_coordinates: ; C: input_coordinates: (routine, branch target or data symbol)
    reserve 510                          ; C: uint8_t buffer[510]; | 255 saved XY words; getl accepts at most 254 bytes

; _______________________________________________________________________
; clear(07) requires console permission. Clear pixels and reset text coordinates.
syscall_clear: ; C: syscall_clear: (routine, branch target or data symbol)
    load r0, & process_flags             ; C: r0 = *(process_flags); | r0 = *(process_flags)
    and r0, PERMISSION_CONSOLE           ; C: r0 &= PERMISSION_CONSOLE; | r0 &= 0x80
    jeq syscall_denied                   ; C: if (Z) goto syscall_denied; | if equal, goto syscall_denied
    write & GPU_ADDRESS, word GPU_CLEAR  ; C: device_write(GPU_ADDRESS, GPU_CLEAR);
    store & console_x, word 0            ; C: *(console_x) = 0; | *(console_x) = 0
    store & console_y, word 0            ; C: *(console_y) = 0; | *(console_y) = 0
    jmp syscall_return                   ; C: goto syscall_return; | goto syscall_return


; SYS_VIDEO R1=1 grants direct AVC64 IO, R1=0 revokes. Console permission is
; checked by dispatch. Grant exactly one physical device, never adjacent keyboard.
; Every new executable starts with an empty EMEM range, so grants do not leak.
syscall_video: ; C: syscall_video: (routine, branch target or data symbol)
    load r0, & arg1                      ; C: r0 = *(arg1);
    cmp r0, 0                            ; C: flags = compare(r0, 0);
    jeq syscall_video_revoke             ; C: if (Z) goto syscall_video_revoke;
    cmp r0, 1                            ; C: flags = compare(r0, 1);
    jne syscall_invalid                  ; C: if (!Z) goto syscall_invalid;
    ireq & GPU_ADDRESS                   ; C: (r0, r1) = device_identify(GPU_ADDRESS);
    cmp r0, GPU_ID                       ; C: flags = compare(r0, GPU_ID);
    jne syscall_video_absent             ; C: if (!Z) goto syscall_video_absent;
    seli GPU_ADDRESS                     ; C: MTU.emem_lower = GPU_ADDRESS;
    sehi GPU_ADDRESS                     ; C: MTU.emem_upper = GPU_ADDRESS;
    load r6, GPU_ADDRESS                 ; C: r6 = GPU_ADDRESS;
    jmp syscall_return                   ; C: goto syscall_return;
syscall_video_revoke: ; C: syscall_video_revoke: (routine, branch target or data symbol)
    seli EMEM_DENY_LOWER                 ; C: MTU.emem_lower = EMEM_DENY_LOWER;
    sehi EMEM_DENY_UPPER                 ; C: MTU.emem_upper = EMEM_DENY_UPPER;
    jmp syscall_return                   ; C: goto syscall_return;
syscall_video_absent: ; C: syscall_video_absent: (routine, branch target or data symbol)
    load r7, FS_BAD_DEVICE               ; C: r7 = FS_BAD_DEVICE;
    jmp syscall_return                   ; C: goto syscall_return;
