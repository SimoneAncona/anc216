; Descriptor and selected-volume services.
; fopen(01): R1 absolute path, L2 size, R3 descriptor-byte pointer.
; Successful open writes descriptor 1. There is only one open file per process.
syscall_open: ; C: syscall_open: (routine, branch target or data symbol)
    load r1, & arg3                      ; C: r1 = *(arg3);
    load r2, 1                           ; C: r2 = 1;
    phbp                                 ; C: push(BP);
    call user_buffer                     ; C: user_buffer();
    pobp                                 ; C: BP = pop_word();
    cmp r7, 0                            ; C: flags = compare(r7, 0);
    jne syscall_return                   ; C: if (!Z) goto syscall_return;
    store & fd_pointer, r1               ; C: *(fd_pointer) = r1;
    load r1, & arg1                      ; C: r1 = *(arg1);
    load r2, & arg2                      ; C: r2 = *(arg2);
    and r2, BYTE_MASK                    ; C: r2 &= BYTE_MASK;
    phbp                                 ; C: push(BP);
    call user_buffer                     ; C: user_buffer();
    pobp                                 ; C: BP = pop_word();
    cmp r7, 0                            ; C: flags = compare(r7, 0);
    jne syscall_return                   ; C: if (!Z) goto syscall_return;
    phbp                                 ; C: push(BP);
    call fs_open                         ; C: fs_open();
    pobp                                 ; C: BP = pop_word();
    cmp r7, 0                            ; C: flags = compare(r7, 0);
    jne syscall_return                   ; C: if (!Z) goto syscall_return;
    load r1, & fd_pointer                ; C: r1 = *(fd_pointer);
    phbp                                 ; C: push(BP);
    ldbp r1                              ; C: BP = r1;
    store & bp + 0, byte 1               ; C: *(bp + 0) = 1;
    pobp                                 ; C: BP = pop_word();
    load r6, 1                           ; C: r6 = 1;
    jmp syscall_return                   ; C: goto syscall_return;
syscall_close: ; C: syscall_close: (routine, branch target or data symbol)
    phbp                                 ; C: push(BP);
    call syscall_check_fd                ; C: syscall_check_fd();
    pobp                                 ; C: BP = pop_word();
    cmp r7, 0                            ; C: flags = compare(r7, 0);
    jne syscall_return                   ; C: if (!Z) goto syscall_return;
    store & fs_head, word 0              ; C: *(fs_head) = 0;
    jmp syscall_return                   ; C: goto syscall_return;
syscall_check_fd: ; C: syscall_check_fd: (routine, branch target or data symbol)
    load r0, & arg1                      ; C: r0 = *(arg1);
    cmp r0, 1                            ; C: flags = compare(r0, 1);
    jne syscall_no_fd                    ; C: if (!Z) goto syscall_no_fd;
    load r0, & fs_head                   ; C: r0 = *(fs_head);
    cmp r0, 0                            ; C: flags = compare(r0, 0);
    jeq syscall_no_fd                    ; C: if (Z) goto syscall_no_fd;
    xor r7, r7                  ; C: r7 = OS_SUCCESS;
    ret                                  ; C: return; // restore CALL PC/SR and discard frame
syscall_no_fd: ; C: syscall_no_fd: (routine, branch target or data symbol)
    load r7, FS_NO_DESCRIPTOR            ; C: r7 = FS_NO_DESCRIPTOR;
    ret                                  ; C: return; // restore CALL PC/SR and discard frame

; fread(03): R1 descriptor, L2 count, R3 destination.
; fwrite(04): R1 descriptor, R2=8000|count, R3 source.
; The high byte is the PDF's write mode; the low byte is its byte count.
syscall_read: ; C: syscall_read: (routine, branch target or data symbol)
    store & transfer_mode, word 0        ; C: *(transfer_mode) = 0;
    jmp syscall_transfer                 ; C: goto syscall_transfer;
syscall_write: ; C: syscall_write: (routine, branch target or data symbol)
    load r0, & arg2                      ; C: r0 = *(arg2);
    and r0, BOOT_PC                      ; C: r0 &= BOOT_PC;
    cmp r0, WRITE_OVERWRITE              ; C: flags = compare(r0, WRITE_OVERWRITE);
    jne syscall_invalid                  ; C: if (!Z) goto syscall_invalid;
    store & transfer_mode, word 1        ; C: *(transfer_mode) = 1;
syscall_transfer: ; C: syscall_transfer: (routine, branch target or data symbol)
    phbp                                 ; C: push(BP);
    call syscall_check_fd                ; C: syscall_check_fd();
    pobp                                 ; C: BP = pop_word();
    cmp r7, 0                            ; C: flags = compare(r7, 0);
    jne syscall_return                   ; C: if (!Z) goto syscall_return;
    load r1, & arg3                      ; C: r1 = *(arg3);
    load r2, & arg2                      ; C: r2 = *(arg2);
    and r2, BYTE_MASK                    ; C: r2 &= BYTE_MASK;
    phbp                                 ; C: push(BP);
    call user_buffer                     ; C: user_buffer();
    pobp                                 ; C: BP = pop_word();
    cmp r7, 0                            ; C: flags = compare(r7, 0);
    jne syscall_return                   ; C: if (!Z) goto syscall_return;
    tran r3, r2                          ; C: r3 = r2;
    tran r2, r1                          ; C: r2 = r1;
    load r4, & transfer_mode             ; C: r4 = *(transfer_mode);
    phbp                                 ; C: push(BP);
    call fs_transfer                     ; C: fs_transfer();
    pobp                                 ; C: BP = pop_word();
    jmp syscall_return                   ; C: goto syscall_return;

; Extensions: mount(10) R1 chip address; exec(11) R1 path/L2 size;
; rewind(12) and size(13) R1 descriptor. Successful exec replaces the process.
syscall_mount: ; C: syscall_mount: (routine, branch target or data symbol)
    load r1, & arg1                      ; C: r1 = *(arg1);
    phbp                                 ; C: push(BP);
    call fs_mount                        ; C: fs_mount();
    pobp                                 ; C: BP = pop_word();
    cmp r7, FS_SUCCESS                   ; C: flags = compare(r7, FS_SUCCESS);
    jne syscall_return                   ; C: if (!Z) goto syscall_return;
    load r0, & arg1                      ; C: r0 = *(arg1);
    store & shell_session_device, r0     ; C: *(shell_session_device) = r0; | cwd and selected volume survive commands
    store & shell_cwd_length, word 1     ; C: *(shell_cwd_length) = 1;
    store & shell_cwd, word ROOT_CWD_WORD ; C: *(shell_cwd) = ROOT_CWD_WORD; | a new volume starts at root
    jmp syscall_return                   ; C: goto syscall_return;
syscall_exec: ; C: syscall_exec: (routine, branch target or data symbol)
    load r1, & arg1                      ; C: r1 = *(arg1);
    load r2, & arg2                      ; C: r2 = *(arg2);
    and r2, BYTE_MASK                    ; C: r2 &= BYTE_MASK;
    phbp                                 ; C: push(BP);
    call user_buffer                     ; C: user_buffer();
    pobp                                 ; C: BP = pop_word();
    cmp r7, 0                            ; C: flags = compare(r7, 0);
    jne syscall_return                   ; C: if (!Z) goto syscall_return;
    phbp                                 ; C: push(BP);
    call fs_open                         ; C: fs_open();
    pobp                                 ; C: BP = pop_word();
    cmp r7, 0                            ; C: flags = compare(r7, 0);
    jne syscall_return                   ; C: if (!Z) goto syscall_return;
    phbp                                 ; C: push(BP);
    call exec_open_file                  ; C: exec_open_file();
    pobp                                 ; C: BP = pop_word();
    jmp syscall_return                   ; C: goto syscall_return;
syscall_rewind: ; C: syscall_rewind: (routine, branch target or data symbol)
    phbp                                 ; C: push(BP);
    call syscall_check_fd                ; C: syscall_check_fd();
    pobp                                 ; C: BP = pop_word();
    cmp r7, 0                            ; C: flags = compare(r7, 0);
    jne syscall_return                   ; C: if (!Z) goto syscall_return;
    phbp                                 ; C: push(BP);
    call fs_rewind                       ; C: fs_rewind();
    pobp                                 ; C: BP = pop_word();
    jmp syscall_return                   ; C: goto syscall_return;
syscall_size: ; C: syscall_size: (routine, branch target or data symbol)
    phbp                                 ; C: push(BP);
    call syscall_check_fd                ; C: syscall_check_fd();
    pobp                                 ; C: BP = pop_word();
    cmp r7, 0                            ; C: flags = compare(r7, 0);
    jne syscall_return                   ; C: if (!Z) goto syscall_return;
    load r6, & fs_size                   ; C: r6 = *(fs_size);
    jmp syscall_return                   ; C: goto syscall_return;

fd_pointer: ; C: fd_pointer: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
transfer_mode: ; C: transfer_mode: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };

