; Working directory, command handoff and return to init.
; _______________________________________________________________________
; getcwd(1b): R1 buffer/R2 capacity; R6 bytes excluding NUL.
; chdir(1c): R1 normalized absolute path/R2 length; require an existing directory.
; Cwd belongs to the session, so it survives command executable replacement.
syscall_getcwd: ; C: syscall_getcwd: (routine, branch target or data symbol)
    load r1, & arg1                      ; C: r1 = *(arg1); | r1 = *(arg1)
    load r2, & arg2                      ; C: r2 = *(arg2); | r2 = *(arg2)
    cmp r2, & shell_cwd_length           ; C: flags = compare(r2, *(shell_cwd_length)); | compare r2 with *(shell_cwd_length)
    jle syscall_invalid                  ; C: if (N != O || Z) goto syscall_invalid; | capacity includes the trailing NUL
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call user_buffer                     ; C: user_buffer(); | user_buffer()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    cmp r7, FS_SUCCESS                   ; C: flags = compare(r7, FS_SUCCESS); | compare r7 with FS_SUCCESS
    jne syscall_return                   ; C: if (!Z) goto syscall_return; | if not equal, goto syscall_return
    tran r3, r1                          ; C: r3 = r1; | r3 = r1
    load r4, shell_cwd                   ; C: r4 = shell_cwd; | r4 = shell_cwd
    load r5, & shell_cwd_length          ; C: r5 = *(shell_cwd_length); | r5 = *(shell_cwd_length)
    inc r5                               ; C: r5++; | r5++
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call shell_copy_bytes                ; C: shell_copy_bytes(); | shell_copy_bytes()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    load r6, & shell_cwd_length          ; C: r6 = *(shell_cwd_length); | r6 = *(shell_cwd_length)
    jmp syscall_return                   ; C: goto syscall_return; | goto syscall_return
syscall_chdir: ; C: syscall_chdir: (routine, branch target or data symbol)
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call syscall_namespace_path          ; C: syscall_namespace_path(); | syscall_namespace_path()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    cmp r7, FS_SUCCESS                   ; C: flags = compare(r7, FS_SUCCESS); | compare r7 with FS_SUCCESS
    jne syscall_return                   ; C: if (!Z) goto syscall_return; | if not equal, goto syscall_return
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call fs_directory                    ; C: fs_directory(); | fs_directory()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    cmp r7, FS_SUCCESS                   ; C: flags = compare(r7, FS_SUCCESS); | compare r7 with FS_SUCCESS
    jne syscall_return                   ; C: if (!Z) goto syscall_return; | if not equal, goto syscall_return
    load r1, & arg1                      ; C: r1 = *(arg1); | r1 = *(arg1)
    add r1, USER_BASE                    ; C: r1 += USER_BASE; | r1 += 0x4000
    tran r4, r1                          ; C: r4 = r1; | r4 = r1
    load r3, shell_cwd                   ; C: r3 = shell_cwd; | r3 = shell_cwd
    load r5, & arg2                      ; C: r5 = *(arg2); | r5 = *(arg2)
    and r5, BYTE_MASK                    ; C: r5 &= BYTE_MASK; | r5 &= 0xff
    store & shell_cwd_length, r5         ; C: *(shell_cwd_length) = r5; | *(shell_cwd_length) = r5
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call shell_copy_bytes                ; C: shell_copy_bytes(); | shell_copy_bytes()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    load r3, shell_cwd                   ; C: r3 = shell_cwd; | r3 = shell_cwd
    add r3, & shell_cwd_length           ; C: r3 += *(shell_cwd_length); | r3 += *(shell_cwd_length)
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    ldbp r3                              ; C: BP = r3; | BP = r3 (physical pointer or saved frame)
    store & bp + 0, byte 0               ; C: *(bp + 0) = 0; | *(bp + 0) = 0
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    jmp syscall_return                   ; C: goto syscall_return; | goto syscall_return

; _______________________________________________________________________
; run(1a): R1 executable/R2 path length, R3 arguments/R4 argument length.
; Save arguments in kernel memory before exec clears the old user's IMEM.
; On successful launch the command receives R1=3000/R2=length; exit/fault
; reloads /bin/init. Failed validation leaves the invoking shell alive.
syscall_run: ; C: syscall_run: (routine, branch target or data symbol)
    load r1, & arg3                      ; C: r1 = *(arg3); | r1 = *(arg3)
    load r2, & arg4                      ; C: r2 = *(arg4); | r2 = *(arg4)
    cmp r2, SHELL_PATH_CAPACITY          ; C: flags = compare(r2, SHELL_PATH_CAPACITY); | compare r2 with SHELL_PATH_CAPACITY
    jge syscall_invalid                  ; C: if (N == O) goto syscall_invalid; | if greater or equal, goto syscall_invalid
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call user_buffer                     ; C: user_buffer(); | user_buffer()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    cmp r7, FS_SUCCESS                   ; C: flags = compare(r7, FS_SUCCESS); | compare r7 with FS_SUCCESS
    jne syscall_return                   ; C: if (!Z) goto syscall_return; | if not equal, goto syscall_return
    tran r4, r1                          ; C: r4 = r1; | r4 = r1
    load r3, shell_arguments             ; C: r3 = shell_arguments; | r3 = shell_arguments
    tran r5, r2                          ; C: r5 = r2; | r5 = r2
    store & shell_argument_length, r2    ; C: *(shell_argument_length) = r2; | *(shell_argument_length) = r2
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call shell_copy_bytes                ; C: shell_copy_bytes(); | shell_copy_bytes()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    load r1, BOOT_DEVICE                 ; C: r1 = BOOT_DEVICE; | executable lookup always uses the boot volume
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call fs_mount                        ; C: fs_mount(); | fs_mount()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    cmp r7, FS_SUCCESS                   ; C: flags = compare(r7, FS_SUCCESS); | compare r7 with FS_SUCCESS
    jne shell_launch_error               ; C: if (!Z) goto shell_launch_error; | if not equal, goto shell_launch_error
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call syscall_namespace_path          ; C: syscall_namespace_path(); | syscall_namespace_path()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    cmp r7, FS_SUCCESS                   ; C: flags = compare(r7, FS_SUCCESS); | compare r7 with FS_SUCCESS
    jne shell_launch_error               ; C: if (!Z) goto shell_launch_error; | if not equal, goto shell_launch_error
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call fs_open                         ; C: fs_open(); | fs_open()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    cmp r7, FS_SUCCESS                   ; C: flags = compare(r7, FS_SUCCESS); | compare r7 with FS_SUCCESS
    jne shell_launch_error               ; C: if (!Z) goto shell_launch_error; | if not equal, goto shell_launch_error
    store & shell_launch_pending, word 1 ; C: *(shell_launch_pending) = 1; | *(shell_launch_pending) = 1
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call exec_open_file                  ; C: exec_open_file(); | exec_open_file()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
shell_launch_error: ; C: shell_launch_error: (routine, branch target or data symbol)
    push r7                              ; C: push(r7); | restore the data volume even on launch failure
    load r1, & shell_session_device      ; C: r1 = *(shell_session_device); | r1 = *(shell_session_device)
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call fs_mount                        ; C: fs_mount(); | fs_mount()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    pop r7                               ; C: r7 = pop(); | restore r7 from the stack
    store & shell_launch_pending, word 0 ; C: *(shell_launch_pending) = 0; | *(shell_launch_pending) = 0
    store & shell_argument_length, word 0 ; C: *(shell_argument_length) = 0; | *(shell_argument_length) = 0
    jmp syscall_return                   ; C: goto syscall_return; | goto syscall_return

; R4 source/R3 destination/R5 byte count, physical addresses. Zero count is safe.
shell_copy_bytes: ; C: shell_copy_bytes: (routine, branch target or data symbol)
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
shell_copy_loop: ; C: shell_copy_loop: (routine, branch target or data symbol)
    cmp r5, 0                            ; C: flags = compare(r5, 0); | compare r5 with 0
    jeq shell_copy_done                  ; C: if (Z) goto shell_copy_done; | if equal, goto shell_copy_done
    ldbp r4                              ; C: BP = r4; | BP = r4 (physical pointer or saved frame)
    load l0, & bp + 0                    ; C: l0 = *(bp + 0); | l0 = *(bp + 0)
    ldbp r3                              ; C: BP = r3; | BP = r3 (physical pointer or saved frame)
    store & bp + 0, l0                   ; C: *(bp + 0) = l0; | *(bp + 0) = l0
    inc r4                               ; C: r4++; | r4++
    inc r3                               ; C: r3++; | r3++
    dec r5                               ; C: r5--; | r5--
    jmp shell_copy_loop                  ; C: goto shell_copy_loop; | goto shell_copy_loop
shell_copy_done: ; C: shell_copy_done: (routine, branch target or data symbol)
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    ret                                  ; C: return; // restore CALL PC/SR and discard frame | return through this routine's CALL frame

; Reload init without clearing the screen or cwd. The boot volume is explicit;
; a command may have mounted another chip, but init lives on the boot chip.
shell_restart: ; C: shell_restart: (routine, branch target or data symbol)
    store & shell_return_pending, word 0 ; C: *(shell_return_pending) = 0; | *(shell_return_pending) = 0
    store & shell_launch_pending, word 0 ; C: *(shell_launch_pending) = 0; | *(shell_launch_pending) = 0
    store & shell_argument_length, word 0 ; C: *(shell_argument_length) = 0; | *(shell_argument_length) = 0
    load r1, BOOT_DEVICE                 ; C: r1 = BOOT_DEVICE; | boot card is at EMEM 0x3000
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call fs_mount                        ; C: fs_mount(); | fs_mount()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    cmp r7, FS_SUCCESS                   ; C: flags = compare(r7, FS_SUCCESS); | compare r7 with FS_SUCCESS
    jne idle                             ; C: if (!Z) goto idle; | if not equal, goto idle
    load r1, init_path                   ; C: r1 = init_path; | r1 = init_path
    load r2, sizeof init_path            ; C: r2 = sizeof init_path; | r2 = sizeof init_path
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call fs_open                         ; C: fs_open(); | fs_open()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    cmp r7, FS_SUCCESS                   ; C: flags = compare(r7, FS_SUCCESS); | compare r7 with FS_SUCCESS
    jne idle                             ; C: if (!Z) goto idle; | if not equal, goto idle
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call exec_open_file                  ; C: exec_open_file(); | exec_open_file()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    jmp idle                             ; C: goto idle; | invalid/missing init leaves a quiet kernel
shell_entry_pointer: ; C: shell_entry_pointer: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
shell_launch_pending: ; C: shell_launch_pending: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
shell_return_pending: ; C: shell_return_pending: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
shell_argument_length: ; C: shell_argument_length: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
shell_arguments: ; C: shell_arguments: (routine, branch target or data symbol)
    reserve SHELL_PATH_CAPACITY          ; C: uint8_t buffer[SHELL_PATH_CAPACITY];
shell_cwd_length: ; C: shell_cwd_length: (routine, branch target or data symbol)
    word 1                               ; C: uint16_t data[] = { 1 };
shell_cwd: ; C: shell_cwd: (routine, branch target or data symbol)
    "/", byte 0                          ; C: const char text[];
    reserve SHELL_PATH_CAPACITY - 2      ; C: uint8_t buffer[SHELL_PATH_CAPACITY - 2];
shell_session_device: ; C: shell_session_device: (routine, branch target or data symbol)
    word BOOT_DEVICE                     ; C: uint16_t data[] = { BOOT_DEVICE };
