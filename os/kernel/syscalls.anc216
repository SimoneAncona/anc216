; SYSCALL ABI: L0 selects the service; R1/R2/R3 carry arguments.
; R0..R5 preserved; R6 byte count/value, R7 status. Zero means success.
; CPU saves user SP/BP in 31fe/31fc and pushes PC/SR at the configured interrupt stack (3100).
; Return is POSR/POPC, never RET (which is only for CALL frames).
; Interrupts remain masked: argument slots and FS operations are nonreentrant.
syscall_handler: ; C: syscall_handler: (routine, branch target or data symbol)
    store & arg0, r0                     ; C: *(arg0) = r0;
    store & arg1, r1                     ; C: *(arg1) = r1;
    store & arg2, r2                     ; C: *(arg2) = r2;
    store & arg3, r3                     ; C: *(arg3) = r3;
    store & arg4, r4                     ; C: *(arg4) = r4;
    store & arg5, r5                     ; C: *(arg5) = r5;
; Interrupt SP can differ from kernel CALL SP. Capture its frame before
; helpers use BP, rather than assuming that all handlers start at 3000.
    trsp r4                              ; C: r4 = SP;
    sub r4, 3                            ; C: r4 -= 3;
    ldbp r4                              ; C: BP = r4;
    load r5, & bp + 0                    ; C: r5 = *(bp + 0);
    store & syscall_pc, r5               ; C: *(syscall_pc) = r5;
    xor r5, r5                           ; C: r5 = 0;
    load l5, & bp + 2                    ; C: l5 = *(bp + 2);
    store & syscall_sr, r5               ; C: *(syscall_sr) = r5;
    ldbp KERNEL_STACK                    ; C: BP = KERNEL_STACK;
    xor r6, r6                           ; C: r6 = 0;
    xor r7, r7                  ; C: r7 = OS_SUCCESS;
    load r0, & process_active            ; C: r0 = *(process_active);
    cmp r0, 0                            ; C: flags = compare(r0, 0);
    jeq panic                            ; C: if (Z) goto panic;
; Three free bytes above saved SP are needed for the return frame.
; User code can modify SP, so bounds must be checked in system mode.
    load r0, & SAVED_SP                  ; C: r0 = *(SAVED_SP);
    cmp r0, USER_STACK                   ; C: flags = compare(r0, USER_STACK);
    jls syscall_bad_stack                ; C: if (N != O) goto syscall_bad_stack;
    cmp r0, USER_RETURN_LIMIT            ; C: flags = compare(r0, USER_RETURN_LIMIT);
    jgr syscall_bad_stack                ; C: if (N == O && !Z) goto syscall_bad_stack;
    jmp syscall_dispatch                 ; C: goto syscall_dispatch;
syscall_unsupported: ; C: syscall_unsupported: (routine, branch target or data symbol)
    load r7, OS_UNSUPPORTED              ; C: r7 = OS_UNSUPPORTED;
    jmp syscall_return                   ; C: goto syscall_return;
syscall_exit: ; C: syscall_exit: (routine, branch target or data symbol)
    load r1, & arg1                      ; C: r1 = *(arg1);
    store & EXIT_ADDRESS, r1             ; C: *(EXIT_ADDRESS) = r1;
    store & STATE_ADDRESS, word STATE_EXIT ; C: *(STATE_ADDRESS) = STATE_EXIT;
    jmp process_finish                   ; C: goto process_finish;
syscall_bad_stack: ; C: syscall_bad_stack: (routine, branch target or data symbol)
    store & FAULT_ADDRESS, word 4        ; C: *(FAULT_ADDRESS) = 4;
    store & STATE_ADDRESS, word STATE_FAULT ; C: *(STATE_ADDRESS) = STATE_FAULT;
    jmp process_finish                   ; C: goto process_finish;
syscall_denied: ; C: syscall_denied: (routine, branch target or data symbol)
    load r7, OS_PERMISSION               ; C: r7 = OS_PERMISSION;
    jmp syscall_return                   ; C: goto syscall_return;
syscall_invalid: ; C: syscall_invalid: (routine, branch target or data symbol)
    load r7, OS_INVALID                  ; C: r7 = OS_INVALID;
    jmp syscall_return                   ; C: goto syscall_return;

; R1 logical pointer, R2 length -> R1 physical pointer or R7=1.
; User buffers stay below 7ff0, reserving the mode-switch stub at 7ff0.
user_buffer: ; C: user_buffer: (routine, branch target or data symbol)
    cmp r1, 0                            ; C: flags = compare(r1, 0);
    jls user_buffer_bad                  ; C: if (N != O) goto user_buffer_bad;
    cmp r1, USER_BUFFER_LIMIT            ; C: flags = compare(r1, USER_BUFFER_LIMIT);
    jge user_buffer_bad                  ; C: if (N == O) goto user_buffer_bad;
    cmp r2, 0                            ; C: flags = compare(r2, 0);
    jls user_buffer_bad                  ; C: if (N != O) goto user_buffer_bad;
    cmp r2, 255                          ; C: flags = compare(r2, 255);
    jgr user_buffer_bad                  ; C: if (N == O && !Z) goto user_buffer_bad;
    tran r0, r1                          ; C: r0 = r1;
    add r0, r2                           ; C: r0 += r2;
    cmp r0, USER_BUFFER_LIMIT            ; C: flags = compare(r0, USER_BUFFER_LIMIT);
    jgr user_buffer_bad                  ; C: if (N == O && !Z) goto user_buffer_bad;
    add r1, USER_BASE                    ; C: r1 += USER_BASE;
    xor r7, r7                  ; C: r7 = OS_SUCCESS;
    ret                                  ; C: return; // restore CALL PC/SR and discard frame
user_buffer_bad: ; C: user_buffer_bad: (routine, branch target or data symbol)
    load r7, OS_INVALID                  ; C: r7 = OS_INVALID;
    ret                                  ; C: return; // restore CALL PC/SR and discard frame

syscall_return: ; C: syscall_return: (routine, branch target or data symbol)
; Copy the original interrupt PC/SR, convert saved logical user SP/BP to physical,
; push a return frame there, restore inputs, then switch back to user mode.
    load r5, & syscall_pc                ; C: r5 = *(syscall_pc);
    load r4, & syscall_sr                ; C: r4 = *(syscall_sr);
    load r0, & SAVED_SP
    add r0, USER_BASE
    ldsp r0
    load r0, & SAVED_BP
    add r0, USER_BASE
    ldbp r0                              ; POSR converts both back to user offsets
    push r5                              ; C: push(r5);
    push l4                              ; C: push(l4);
    load r0, & arg0                      ; C: r0 = *(arg0);
    load r1, & arg1                      ; C: r1 = *(arg1);
    load r2, & arg2                      ; C: r2 = *(arg2);
    load r3, & arg3                      ; C: r3 = *(arg3);
    load r4, & arg4                      ; C: r4 = *(arg4);
    load r5, & arg5                      ; C: r5 = *(arg5);
; Execute the mode switch inside user IMEM: after POSR the next fetch
; must already be inside the MTU range. Reinstall before each transition.
    store & RETURN_STUB, word RETURN_POSR_WORD ; C: *(RETURN_STUB) = RETURN_POSR_WORD;
    store & RETURN_STUB_PC, word RETURN_POPC_WORD ; C: *(RETURN_STUB_PC) = RETURN_POPC_WORD;
    jmp RETURN_STUB                      ; C: goto RETURN_STUB;

arg0: ; C: arg0: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
arg1: ; C: arg1: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
arg2: ; C: arg2: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
arg3: ; C: arg3: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
arg4: ; C: arg4: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
arg5: ; C: arg5: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
syscall_pc: ; C: syscall_pc: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };
syscall_sr: ; C: syscall_sr: (routine, branch target or data symbol)
    word 0                               ; C: uint16_t data[] = { 0 };


import "syscall_dispatch.anc216" ; C: #include "syscall_dispatch.anc216"
import "syscall_files.anc216" ; C: #include "syscall_files.anc216"
import "syscall_namespace.anc216" ; C: #include "syscall_namespace.anc216"
import "syscall_console.anc216" ; C: #include "syscall_console.anc216"
import "syscall_session.anc216" ; C: #include "syscall_session.anc216"
