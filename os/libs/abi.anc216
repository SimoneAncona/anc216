; Shared OS ABI names. Imported once by each executable, before its helpers.
use SYS_EXIT as 0x00
use SYS_OPEN as 0x01
use SYS_CLOSE as 0x02
use SYS_READ as 0x03
use SYS_WRITE as 0x04
use SYS_PRINT as 0x05
use SYS_GETL as 0x06
use SYS_CLEAR as 0x07
use SYS_MOUNT as 0x10
use SYS_EXEC as 0x11
use SYS_REWIND as 0x12
use SYS_SIZE as 0x13
use SYS_DIRECTORY as 0x14
use SYS_LIST as 0x15
use SYS_TOUCH as 0x16
use SYS_MKDIR as 0x17
use SYS_REMOVE as 0x18
use SYS_RUN as 0x1a
use SYS_GETCWD as 0x1b
use SYS_CHDIR as 0x1c
use SYS_POWEROFF as 0x1d
use OS_SUCCESS as 0
use OS_INVALID as 1
use OS_ENTRY_BYTES as 24
use OS_PATH_CAPACITY as 255
use OS_ARGUMENT_POINTER as 0x3000
use OS_USER_BASE as 0x4000
use ASCII_NUL as 0
use ASCII_SPACE as 32
use ASCII_SLASH as 47
use ASCII_DOT as 46
use ASCII_NEWLINE as 10
use OS_ENTRY_DIRECTORY as 1
use ASCII_DIGIT_ZERO as 48
use ASCII_DIGIT_NINE as 57
use DECIMAL_MULTIPLY_LIMIT as 6553
use OS_NOT_FOUND as 3
use OS_CAPACITY as 6
use OS_PERMISSION as 9
use OS_EXISTS as 10
use OS_NOT_EMPTY as 11
