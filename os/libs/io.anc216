; Small user console helpers. Import abi.anc216 before this module.
; app_print(R1=logical bytes, R2=count<=255): R6=count/R7=status.
app_print:
    load r0, SYS_PRINT                   ; streams 0/1 currently share the console
    load r3, 0                           ; r3 = 0
    syscall                              ; invoke the OS service selected by L0
    ret                                  ; return through this routine's CALL frame
app_newline:
    load r1, app_newline_text            ; r1 = app_newline_text
    load r2, sizeof app_newline_text     ; r2 = sizeof app_newline_text
    phbp                                 ; save BP before pointer/helper use
    call app_print                       ; app_print()
    pobp                                 ; restore the saved BP
    ret                                  ; return through this routine's CALL frame
app_exit:
    load r0, SYS_EXIT                    ; r0 = SYS_EXIT
    load r1, 0                           ; r1 = 0
    syscall                              ; does not return; run reloads init
app_error:
    ; Keep the real status in the exit code as well as a readable message.
    store & app_error_status, r7         ; *(app_error_status) = r7
    cmp r7, OS_INVALID                   ; compare r7 with OS_INVALID
    jeq app_error_invalid                ; if equal, goto app_error_invalid
    cmp r7, OS_NOT_FOUND                 ; compare r7 with OS_NOT_FOUND
    jeq app_error_missing                ; if equal, goto app_error_missing
    cmp r7, OS_CAPACITY                  ; compare r7 with OS_CAPACITY
    jeq app_error_capacity               ; if equal, goto app_error_capacity
    cmp r7, OS_PERMISSION                ; compare r7 with OS_PERMISSION
    jeq app_error_permission             ; if equal, goto app_error_permission
    cmp r7, OS_EXISTS                    ; compare r7 with OS_EXISTS
    jeq app_error_exists                 ; if equal, goto app_error_exists
    cmp r7, OS_NOT_EMPTY                 ; compare r7 with OS_NOT_EMPTY
    jeq app_error_not_empty              ; if equal, goto app_error_not_empty
    load r1, app_error_text              ; r1 = app_error_text
    load r2, sizeof app_error_text       ; r2 = sizeof app_error_text
    jmp app_error_print                  ; goto app_error_print
app_error_invalid:
    load r1, app_error_invalid_text      ; r1 = app_error_invalid_text
    load r2, sizeof app_error_invalid_text ; r2 = sizeof app_error_invalid_text
    jmp app_error_print                  ; goto app_error_print
app_error_missing:
    load r1, app_error_missing_text      ; r1 = app_error_missing_text
    load r2, sizeof app_error_missing_text ; r2 = sizeof app_error_missing_text
    jmp app_error_print                  ; goto app_error_print
app_error_capacity:
    load r1, app_error_capacity_text     ; r1 = app_error_capacity_text
    load r2, sizeof app_error_capacity_text ; r2 = sizeof app_error_capacity_text
    jmp app_error_print                  ; goto app_error_print
app_error_permission:
    load r1, app_error_permission_text   ; r1 = app_error_permission_text
    load r2, sizeof app_error_permission_text ; r2 = sizeof app_error_permission_text
    jmp app_error_print                  ; goto app_error_print
app_error_exists:
    load r1, app_error_exists_text       ; r1 = app_error_exists_text
    load r2, sizeof app_error_exists_text ; r2 = sizeof app_error_exists_text
    jmp app_error_print                  ; goto app_error_print
app_error_not_empty:
    load r1, app_error_not_empty_text    ; r1 = app_error_not_empty_text
    load r2, sizeof app_error_not_empty_text ; r2 = sizeof app_error_not_empty_text
    jmp app_error_print                  ; goto app_error_print
app_error_print:
    phbp                                 ; save BP before pointer/helper use
    call app_print                       ; app_print()
    pobp                                 ; restore the saved BP
    load r0, SYS_EXIT                    ; r0 = SYS_EXIT
    load r1, & app_error_status          ; r1 = *(app_error_status)
    syscall                              ; invoke the OS service selected by L0
app_newline_text:
    byte ASCII_NEWLINE
app_error_text:
    "command failed", ASCII_NEWLINE
app_error_status:
    word 0
app_error_invalid_text:
    "invalid argument", ASCII_NEWLINE
app_error_missing_text:
    "path not found", ASCII_NEWLINE
app_error_capacity_text:
    "disk is full", ASCII_NEWLINE
app_error_permission_text:
    "permission denied", ASCII_NEWLINE
app_error_exists_text:
    "name already exists", ASCII_NEWLINE
app_error_not_empty_text:
    "directory is not empty", ASCII_NEWLINE
