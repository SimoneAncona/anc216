; A standalone user executable. R1 points to argument bytes, R2 is their length.
; Arguments arrive at logical 3000 from run; helpers use checked OS syscalls.
import "../libs/abi.anc216" ; C: #include "../libs/abi.anc216"
_code:
    tran r0, r1                          ; C: r0 = r1; | path_absolute expects R0 pointer/R1 length
    tran r1, r2                          ; C: r1 = r2; | r1 = r2
    cmp r1, 1
    jeq check_home
no_home:
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call path_absolute                   ; C: path_absolute(); | resolve cwd, '.', '..' and repeated slashes
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    cmp r7, OS_SUCCESS                   ; C: flags = compare(r7, OS_SUCCESS); | compare r7 with OS_SUCCESS
    jne app_error                        ; C: if (!Z) goto app_error; | if not equal, goto app_error
    load r0, SYS_CHDIR                   ; C: r0 = SYS_CHDIR; | r0 = SYS_CHDIR
    syscall                              ; C: kernel_service(L0, arguments); | invoke the OS service selected by L0
    cmp r7, OS_SUCCESS                   ; C: flags = compare(r7, OS_SUCCESS); | compare r7 with OS_SUCCESS
    jne app_error                        ; C: if (!Z) goto app_error; | if not equal, goto app_error
    jmp app_exit                         ; C: goto app_exit; | goto app_exit

check_home:
    ldbp r0
    load r5, & bp + 0
    shr r5, 8
    cmp r5, 0x7E                ; if char == '~'
    jne no_home
    load r0, SYS_CHDIR
    load r1, home
    load r2, sizeof home
    syscall
    jmp app_exit
home: "/home"

import "../libs/strings.anc216" ; C: #include "../libs/strings.anc216"
import "../libs/paths.anc216" ; C: #include "../libs/paths.anc216"
import "../libs/io.anc216" ; C: #include "../libs/io.anc216"
