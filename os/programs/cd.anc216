; A standalone user executable. R1 points to argument bytes, R2 is their length.
; Arguments arrive at logical 3000 from run; helpers use checked OS syscalls.
import "../libs/abi.anc216"
_code:
    tran r0, r1                          ; path_absolute expects R0 pointer/R1 length
    tran r1, r2                          ; r1 = r2
    phbp                                 ; save BP before pointer/helper use
    call path_absolute                   ; resolve cwd, '.', '..' and repeated slashes
    pobp                                 ; restore the saved BP
    cmp r7, OS_SUCCESS                   ; compare r7 with OS_SUCCESS
    jne app_error                        ; if not equal, goto app_error
    load r0, SYS_CHDIR                   ; r0 = SYS_CHDIR
    syscall                              ; invoke the OS service selected by L0
    cmp r7, OS_SUCCESS                   ; compare r7 with OS_SUCCESS
    jne app_error                        ; if not equal, goto app_error
    jmp app_exit                         ; goto app_exit

import "../libs/strings.anc216"
import "../libs/paths.anc216"
import "../libs/io.anc216"
