; A standalone user executable. R1 points to argument bytes, R2 is their length.
; Arguments arrive at logical 3000 from run; helpers use checked OS syscalls.
import "../libs/abi.anc216" ; C: #include "../libs/abi.anc216"
_code:
    load r0, SYS_PRINT
    syscall
    cmp r7, OS_SUCCESS
    jne echo_failed
    load r0, SYS_PRINT
    load r1, new_line
    load r2, 1
    syscall
    cmp r7, OS_SUCCESS
    jne echo_failed
    xor r0, r0
    xor r1, r1
    syscall
echo_failed:
    xor r0, r0
    tran r1, r7
    syscall
new_line: 10
