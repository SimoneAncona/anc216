; stat PATH reports recursive payload and real allocated usage for files/directories.
import "../libs/abi.anc216" ; C: #include "../libs/abi.anc216"
_code:
    tran r0, r1                          ; C: r0 = r1;
    tran r1, r2                          ; C: r1 = r2;
    phbp                                 ; C: push(BP);
    call path_absolute                   ; C: path_absolute();
    pobp                                 ; C: BP = pop_word();
    cmp r7, OS_SUCCESS                   ; C: flags = compare(r7, OS_SUCCESS);
    jne app_error                        ; C: if (!Z) goto app_error;
    load r0, SYS_FSTAT                   ; C: r0 = SYS_FSTAT;
    load r3, stat_result                 ; C: r3 = stat_result;
    syscall                              ; C: kernel_service(L0, arguments);
    cmp r7, OS_SUCCESS                   ; C: flags = compare(r7, OS_SUCCESS);
    jne app_error                        ; C: if (!Z) goto app_error;
    load r1, stat_payload_text           ; C: r1 = stat_payload_text;
    load r2, sizeof stat_payload_text    ; C: r2 = sizeof stat_payload_text;
    phbp                                 ; C: push(BP);
    call app_print                       ; C: app_print();
    pobp                                 ; C: BP = pop_word();
    load r1, & stat_result + 2           ; C: r1 = *(stat_result + 2);
    phbp                                 ; C: push(BP);
    call app_print_unsigned              ; C: app_print_unsigned();
    pobp                                 ; C: BP = pop_word();
    phbp                                 ; C: push(BP);
    call app_newline                     ; C: app_newline();
    pobp                                 ; C: BP = pop_word();
    load r1, stat_disk_text              ; C: r1 = stat_disk_text;
    load r2, sizeof stat_disk_text       ; C: r2 = sizeof stat_disk_text;
    phbp                                 ; C: push(BP);
    call app_print                       ; C: app_print();
    pobp                                 ; C: BP = pop_word();
    load r1, & stat_result + 4           ; C: r1 = *(stat_result + 4);
    phbp                                 ; C: push(BP);
    call app_print_unsigned              ; C: app_print_unsigned();
    pobp                                 ; C: BP = pop_word();
    load r1, stat_disk_outof
    load r2, sizeof stat_disk_outof
    phbp
    call app_print
    pobp
    phbp                                 ; C: push(BP);
    call app_newline                     ; C: app_newline();
    pobp                                 ; C: BP = pop_word();
    load r1, stat_units_text             ; C: r1 = stat_units_text;
    load r2, sizeof stat_units_text      ; C: r2 = sizeof stat_units_text;
    phbp                                 ; C: push(BP);
    call app_print                       ; C: app_print();
    pobp                                 ; C: BP = pop_word();
    load r1, & stat_result + 6           ; C: r1 = *(stat_result + 6);
    phbp                                 ; C: push(BP);
    call app_print_unsigned              ; C: app_print_unsigned();
    pobp                                 ; C: BP = pop_word();
    load r1, stat_units_outof
    load r2, sizeof stat_units_outof
    phbp
    call app_print
    pobp
    phbp                                 ; C: push(BP);
    call app_newline                     ; C: app_newline();
    pobp                                 ; C: BP = pop_word();
    jmp app_exit                         ; C: goto app_exit;
stat_result:
    reserve OS_STAT_BYTES                ; C: uint8_t buffer[OS_STAT_BYTES];
stat_payload_text:
    "payload bytes: "                    ; C: const char text[];
stat_disk_text:
    "allocated bytes: "                  ; C: const char text[];
stat_units_text:
    "allocation units: "                 ; C: const char text[];
stat_disk_outof:
    "/64k"
stat_units_outof:
    "/196"
import "../libs/strings.anc216" ; C: #include "../libs/strings.anc216"
import "../libs/paths.anc216" ; C: #include "../libs/paths.anc216"
import "../libs/numbers.anc216" ; C: #include "../libs/numbers.anc216"
import "../libs/io.anc216" ; C: #include "../libs/io.anc216"
