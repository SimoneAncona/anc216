; A standalone user executable. R1 points to argument bytes, R2 is their length.
; Arguments arrive at logical 3000 from run; helpers use checked OS syscalls.
import "../libs/abi.anc216"
_code:
    tran r0, r1                          ; r0 = r1
    tran r1, r2                          ; r1 = r2
    phbp                                 ; save BP before pointer/helper use
    call path_absolute                   ; empty argument selects the current directory
    pobp                                 ; restore the saved BP
    cmp r7, OS_SUCCESS                   ; compare r7 with OS_SUCCESS
    jne app_error                        ; if not equal, goto app_error
    store & ls_path_length, r2           ; *(ls_path_length) = r2
    store & ls_cursor, word 0            ; *(ls_cursor) = 0
ls_next:
    load r0, SYS_LIST                    ; r0 = SYS_LIST
    load r1, path_result                 ; r1 = path_result
    load r2, & ls_path_length            ; r2 = *(ls_path_length)
    load r3, ls_entry                    ; r3 = ls_entry
    load r4, & ls_cursor                 ; r4 = *(ls_cursor)
    syscall                              ; invoke the OS service selected by L0
    cmp r7, OS_SUCCESS                   ; compare r7 with OS_SUCCESS
    jne app_error                        ; if not equal, goto app_error
    cmp r6, 0                            ; compare r6 with 0
    jeq app_exit                         ; EOF: cursor zero, not an error
    store & ls_cursor, r6                ; *(ls_cursor) = r6
    load r0, ls_entry + 1                ; r0 = ls_entry + 1
    load r1, OS_ENTRY_BYTES - 1          ; r1 = OS_ENTRY_BYTES - 1
    phbp                                 ; save BP before pointer/helper use
    call str_nulterm_len                 ; str_nulterm_len()
    pobp                                 ; restore the saved BP
    cmp r7, OS_SUCCESS                   ; compare r7 with OS_SUCCESS
    jne app_error                        ; if not equal, goto app_error
    load r1, ls_entry + 1                ; r1 = ls_entry + 1
    tran r2, r6                          ; r2 = r6
    phbp                                 ; save BP before pointer/helper use
    call app_print                       ; app_print()
    pobp                                 ; restore the saved BP
    load r0, 0                           ; r0 = 0
    load l0, & ls_entry                  ; l0 = *(ls_entry)
    cmp r0, OS_ENTRY_DIRECTORY           ; compare r0 with OS_ENTRY_DIRECTORY
    jne ls_newline                       ; if not equal, goto ls_newline
    load r1, ls_slash                    ; r1 = ls_slash
    load r2, sizeof ls_slash             ; r2 = sizeof ls_slash
    phbp                                 ; save BP before pointer/helper use
    call app_print                       ; distinguish directories with a trailing '/'
    pobp                                 ; restore the saved BP
ls_newline:
    phbp                                 ; save BP before pointer/helper use
    call app_newline                     ; app_newline()
    pobp                                 ; restore the saved BP
    jmp ls_next                          ; goto ls_next
ls_path_length:
    word 0
ls_cursor:
    word 0
ls_entry:
    reserve OS_ENTRY_BYTES
ls_slash:
    byte ASCII_SLASH

import "../libs/strings.anc216"
import "../libs/paths.anc216"
import "../libs/io.anc216"
