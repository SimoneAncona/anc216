; A standalone user executable. R1 points to argument bytes, R2 is their length.
; Arguments arrive at logical 3000 from run; helpers use checked OS syscalls.
import "../libs/abi.anc216" ; C: #include "../libs/abi.anc216"
_code:
    tran r0, r1                          ; C: r0 = r1; | r0 = r1
    tran r1, r2                          ; C: r1 = r2; | r1 = r2
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call path_absolute                   ; C: path_absolute(); | empty argument selects the current directory
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    cmp r7, OS_SUCCESS                   ; C: flags = compare(r7, OS_SUCCESS); | compare r7 with OS_SUCCESS
    jne app_error                        ; C: if (!Z) goto app_error; | if not equal, goto app_error
    store & ls_path_length, r2           ; C: *(ls_path_length) = r2; | *(ls_path_length) = r2
    store & ls_cursor, word 0            ; C: *(ls_cursor) = 0; | *(ls_cursor) = 0
ls_next:
    load r0, SYS_LIST                    ; C: r0 = SYS_LIST; | r0 = SYS_LIST
    load r1, path_result                 ; C: r1 = path_result; | r1 = path_result
    load r2, & ls_path_length            ; C: r2 = *(ls_path_length); | r2 = *(ls_path_length)
    load r3, ls_entry                    ; C: r3 = ls_entry; | r3 = ls_entry
    load r4, & ls_cursor                 ; C: r4 = *(ls_cursor); | r4 = *(ls_cursor)
    syscall                              ; C: kernel_service(L0, arguments); | invoke the OS service selected by L0
    cmp r7, OS_SUCCESS                   ; C: flags = compare(r7, OS_SUCCESS); | compare r7 with OS_SUCCESS
    jne app_error                        ; C: if (!Z) goto app_error; | if not equal, goto app_error
    cmp r6, 0                            ; C: flags = compare(r6, 0); | compare r6 with 0
    jeq app_exit                         ; C: if (Z) goto app_exit; | EOF: cursor zero, not an error
    store & ls_cursor, r6                ; C: *(ls_cursor) = r6; | *(ls_cursor) = r6
    load r0, ls_entry + 1                ; C: r0 = ls_entry + 1; | r0 = ls_entry + 1
    load r1, OS_ENTRY_BYTES - 1          ; C: r1 = OS_ENTRY_BYTES - 1; | r1 = OS_ENTRY_BYTES - 1
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call str_nulterm_len                 ; C: str_nulterm_len(); | str_nulterm_len()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    cmp r7, OS_SUCCESS                   ; C: flags = compare(r7, OS_SUCCESS); | compare r7 with OS_SUCCESS
    jne app_error                        ; C: if (!Z) goto app_error; | if not equal, goto app_error
    load r1, ls_entry + 1                ; C: r1 = ls_entry + 1; | r1 = ls_entry + 1
    tran r2, r6                          ; C: r2 = r6; | r2 = r6
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call app_print                       ; C: app_print(); | app_print()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    load r0, 0                           ; C: r0 = 0; | r0 = 0
    load l0, & ls_entry                  ; C: l0 = *(ls_entry); | l0 = *(ls_entry)
    cmp r0, OS_ENTRY_DIRECTORY           ; C: flags = compare(r0, OS_ENTRY_DIRECTORY); | compare r0 with OS_ENTRY_DIRECTORY
    jne ls_newline                       ; C: if (!Z) goto ls_newline; | if not equal, goto ls_newline
    load r1, ls_slash                    ; C: r1 = ls_slash; | r1 = ls_slash
    load r2, sizeof ls_slash             ; C: r2 = sizeof ls_slash; | r2 = sizeof ls_slash
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call app_print                       ; C: app_print(); | distinguish directories with a trailing '/'
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
ls_newline:
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
    call app_newline                     ; C: app_newline(); | app_newline()
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    jmp ls_next                          ; C: goto ls_next; | goto ls_next
ls_path_length:
    word 0                               ; C: uint16_t data[] = { 0 };
ls_cursor:
    word 0                               ; C: uint16_t data[] = { 0 };
ls_entry:
    reserve OS_ENTRY_BYTES               ; C: uint8_t buffer[OS_ENTRY_BYTES];
ls_slash:
    byte ASCII_SLASH                     ; C: uint8_t data[] = { ASCII_SLASH };

import "../libs/strings.anc216" ; C: #include "../libs/strings.anc216"
import "../libs/paths.anc216" ; C: #include "../libs/paths.anc216"
import "../libs/io.anc216" ; C: #include "../libs/io.anc216"
