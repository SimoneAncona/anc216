import "../libs/abi.anc216"
_code:
    load r1, lower_index
    load r2, sizeof lower_index
    phbp
    call app_print
    pobp
    teli r1
    phbp
    call app_print_unsigned
    pobp
    phbp
    call app_newline
    pobp
    load r1, upper_index
    load r2, sizeof upper_index
    phbp
    call app_print
    pobp
    tehi r1
    phbp
    call app_print_unsigned
    pobp
    phbp
    call app_newline
    pobp
    load r1, scanning_devices
    load r2, sizeof scanning_devices
    phbp
    call app_print
    pobp
    xor r0, r0
device_scan:
    cmp r0, & block
    jeq exit
    push r0 ; r0 as address
    ireq r0 ; ireq at address r0, after this r0 = device id, r1 = address
    cmp r0, 0xffff
    jeq next_dev
    push r0 ; push r0 that contains the device id
    phbp
    call app_print_unsigned
    pobp
    load r1, space
    load r2, sizeof space
    phbp
    call app_print
    pobp
    pop r1
    push r1
    phbp
    call app_print_unsigned
    pobp
    load r1, space
    load r2, sizeof space
    phbp
    call app_print
    pobp
    pop r1
    cmp r1, 0x0201
    jne noavc64
    load r1, avc64_msg
    load r2, sizeof avc64_msg
    phbp
    call app_print
    pobp
    jmp continue
noavc64:
    cmp r1, 0x0102
    jne nompme
    load r1, mpme216_msg
    load r2, sizeof mpme216_msg
    phbp
    call app_print
    pobp
    jmp continue
nompme:
    cmp r1, 0x0301
    jne nokbd
    load r1, kbd_msg
    load r2, sizeof kbd_msg
    phbp
    call app_print
    pobp
    jmp continue
nokbd:
    cmp r1, 0
    jne unknown
    load r1, rom_msg
    load r2, sizeof rom_msg
    phbp
    call app_print
    pobp
    jmp continue
unknown:
    load r1, unknown_msg
    load r2, sizeof unknown_msg
    phbp
    call app_print
    pobp
continue:
    phbp
    call app_newline
    pobp
next_dev:
    pop r0
    inc r0
    jmp device_scan
exit:
    call app_exit

block:
    word 0xffff


lower_index:
    "Lower index: "
upper_index:
    "Upper index: "
scanning_devices:
    "Scanning devices...", 10
space:
    "    "
avc64_msg:
    "(AVC64)"
mpme216_msg:
    "(MPME216)"
unknown_msg:
    "(Unknown)"
kbd_msg:
    "(Keyboard)"
rom_msg:
    "(ROM)"

import "../libs/io.anc216"
import "../libs/numbers.anc216"
