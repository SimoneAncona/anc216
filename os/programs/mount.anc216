; A standalone user executable. R1 points to argument bytes, R2 is their length.
; Arguments arrive at logical 3000 from run; helpers use checked OS syscalls.
import "../libs/abi.anc216" ; C: #include "../libs/abi.anc216"
_code:
    cmp r2, 0                            ; C: flags = compare(r2, 0); | compare r2 with 0
    jeq app_error                        ; C: if (Z) goto app_error; | if equal, goto app_error
    tili r5                              ; C: r5 = MTU.imem_lower; | r5 = MTU IMEM base
    add r1, r5                           ; C: r1 += r5; | r1 += r5
    xor r4, r4                           ; C: r4 = 0; | decimal EMEM chip address accumulator
    phbp                                 ; C: push(BP); | save BP before pointer/helper use
mount_digit:
    ldbp r1                              ; C: BP = r1; | BP = r1 (physical pointer or saved frame)
    xor r0, r0                           ; C: r0 = 0; | r0 = 0
    load l0, & bp + 0                    ; C: l0 = *(bp + 0); | l0 = *(bp + 0)
    cmp r0, ASCII_DIGIT_ZERO             ; C: flags = compare(r0, ASCII_DIGIT_ZERO); | compare r0 with ASCII_DIGIT_ZERO
    jls mount_bad                        ; C: if (N != O) goto mount_bad; | if less, goto mount_bad
    cmp r0, ASCII_DIGIT_NINE             ; C: flags = compare(r0, ASCII_DIGIT_NINE); | compare r0 with ASCII_DIGIT_NINE
    jgr mount_bad                        ; C: if (N == O && !Z) goto mount_bad; | if greater, goto mount_bad
    sub r0, ASCII_DIGIT_ZERO             ; C: r0 -= ASCII_DIGIT_ZERO; | r0 -= ASCII_DIGIT_ZERO
    cmp r4, DECIMAL_MULTIPLY_LIMIT       ; C: flags = compare(r4, DECIMAL_MULTIPLY_LIMIT); | compare r4 with DECIMAL_MULTIPLY_LIMIT
    jgr mount_bad                        ; C: if (N == O && !Z) goto mount_bad; | multiplication by ten must not overflow
    tran r3, r4                          ; C: r3 = r4; | r3 = r4
    shl r4, 3                            ; C: r4 <<= 3; | r4 <<= 3
    shl r3, 1                            ; C: r3 <<= 1; | r3 <<= 1
    add r4, r3                           ; C: r4 += r3; | r4 += r3
    add r4, r0                           ; C: r4 += r0; | r4 += r0
    trsr l3                              ; C: l3 = SR; | l3 = SR (inspect flags from the preceding operation)
    and l3, 1                            ; C: l3 &= 1; | l3 &= 1
    jne mount_bad                        ; C: if (!Z) goto mount_bad; | if not equal, goto mount_bad
    inc r1                               ; C: r1++; | r1++
    dec r2                               ; C: r2--; | r2--
    jne mount_digit                      ; C: if (!Z) goto mount_digit; | if not equal, goto mount_digit
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    load r0, SYS_MOUNT                   ; C: r0 = SYS_MOUNT; | r0 = SYS_MOUNT
    tran r1, r4                          ; C: r1 = r4; | r1 = r4
    syscall                              ; C: kernel_service(L0, arguments); | invoke the OS service selected by L0
    cmp r7, OS_SUCCESS                   ; C: flags = compare(r7, OS_SUCCESS); | compare r7 with OS_SUCCESS
    jne app_error                        ; C: if (!Z) goto app_error; | if not equal, goto app_error
    jmp app_exit                         ; C: goto app_exit; | goto app_exit
mount_bad:
    pobp                                 ; C: BP = pop_word(); | restore the saved BP
    load r7, OS_INVALID                  ; C: r7 = OS_INVALID; | r7 = OS_INVALID
    jmp app_error                        ; C: goto app_error; | goto app_error

import "../libs/strings.anc216" ; C: #include "../libs/strings.anc216"
import "../libs/paths.anc216" ; C: #include "../libs/paths.anc216"
import "../libs/io.anc216" ; C: #include "../libs/io.anc216"
